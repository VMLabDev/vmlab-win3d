import <vmlab.wcl>

// Regression lab on helios for patches/mesa/0021: labs/probe/vmlab.wcl with
// its own lab name, run by labs/zeus/run.sh --gpu amd. That file says:
// Minimal lab that gives a Windows 11 guest a working Venus device on this
// host. Needs vmlab >= 0.24.0-alpha, which emits
// virtio-vga-gl,venus=true,blob=true,hostmem=4G, takes the host GPU from
// gpu.address (render node for egl-headless and the Vulkan ICD filter in
// QEMU's own environment) and screenshots GL displays over VNC.
// See docs/host.md and vmlab handoff 20261017-142905.
lab "win3d-zeus-amd" {
  vm "win" {
    template = "x86_64/windows-11@26100.1742.5"
    // The template's windows-11 profile turns Secure Boot on; the test-signed
    // driver package needs it off (docs/decisions/0001-signing.md).
    secure_boot = false
    // 0000:72:00.0 is the AMD iGPU (RADV, renderD129). Venus on the RTX 5090s
    // does not work yet (docs/known-limits.md).
    gpu {
      mode    = "vulkan"
      address = "0000:72:00.0"
    }
  }
}
