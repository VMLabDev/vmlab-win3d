import <vmlab-host.wcl>

// Host GPUs on helios. A lab's `gpu {}` names one with `host_gpu`, or takes the default.
gpu "AMD1"    { address = "0000:72:00.0" }                  // Ryzen 9 9950X iGPU (amdgpu, renderD129)
gpu "Nvidia1" {                                             // RTX 5090 (nvidia, renderD128)
  address     = "0000:01:00.0"
  default     = true
  // QEMU (upstream master + our egl-headless external-only dma-buf series)
  // (VMLabDev/qemu vmlab/egl-headless-external-dmabuf, d8a6048aae); stock
  // QEMU shows a black console for a Venus guest on NVIDIA.
  qemu_binary = "/home/wil/.local/opt/qemu-vmlab-egl/bin/qemu-system-x86_64"
  qemu_env    = { RENDER_SERVER_EXEC_PATH: "/home/wil/dev/vmlab-win3d-wt/godot/.scratch/vkr/virglrenderer-1.3.0/b/server/virgl_render_server", VKR_TRACE: "/home/wil/dev/vmlab-win3d-wt/godot/.scratch/trace", VKR_SYNC_SUBMIT: "1", VKR_TRACE_APP: "Godot|Particles|particles", VKR_DEBUG: "validate", VK_ADD_LAYER_PATH: "/home/wil/dev/vmlab-win3d-wt/godot/.scratch/tools/vvl/usr/share/vulkan/explicit_layer.d" }
}
gpu "Nvidia2" {                                             // RTX 5090 (nvidia, renderD130)
  address     = "0000:05:00.0"
  // Same patched QEMU as Nvidia1 (egl-headless external-only dma-buf fix).
  qemu_binary = "/home/wil/.local/opt/qemu-vmlab-egl/bin/qemu-system-x86_64"
}
