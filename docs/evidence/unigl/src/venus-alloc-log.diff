+#include <stdarg.h>
+#include <stdio.h>
+#if defined(_WIN32)
+#include <windows.h>
+#endif
+static void
+vn_unigl_log(const char *fmt, ...)
+{
+   FILE *f = fopen("C:\\ProgramData\\Yttrium\\venus-unigl.log", "a");
+   if (!f)
+      return;
+#if defined(_WIN32)
+   SYSTEMTIME st;
+   GetLocalTime(&st);
+   char exe[MAX_PATH] = "";
+   GetModuleFileNameA(NULL, exe, sizeof(exe));
+   const char *base = strrchr(exe, '\\');
+   fprintf(f, "%02u:%02u:%02u.%03u pid=%lu %s ", st.wHour, st.wMinute,
+           st.wSecond, st.wMilliseconds, GetCurrentProcessId(),
+           base ? base + 1 : exe);
+#endif
+   va_list ap;
+   va_start(ap, fmt);
+   vfprintf(f, fmt, ap);
+   va_end(ap);
+   fputc('\n', f);
+   fclose(f);
+}
