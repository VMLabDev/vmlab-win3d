import <vmlab.wcl>

// Acceptance lab for tests/e2e/run.sh: the labs/probe/vmlab.wcl shape
// (vmlab >= 0.25.0-alpha; docs/host.md, docs/install.md). run.sh copies this
// file into .scratch/e2e/<template>/lab/ and rewrites the lab name and the
// template line for --template; as committed it is the windows-11 lab.
lab "win3d-e2e-windows-10" {
  vm "win" {
    template = "x86_64/windows-10@19045.2006.8"
    // The package is test-signed (decision 0001); Secure Boot must be off.
    secure_boot = false
    // The templates' agent cannot be updated in place (the service does not
    // restart onto it), and a late restart dropped the agent channel mid-exec
    // on windows-10. Keep the template's agent.
    agent_update = false
    // AMD1 is the host config's AMD iGPU (0000:72:00.0, RADV, renderD129). The
    // host's default GPU on helios is an RTX 5090, whose console is black
    // with stock QEMU (docs/known-limits.md).
    gpu {
      mode     = "vulkan"
      host_gpu = "AMD1"
    }
  }
}
