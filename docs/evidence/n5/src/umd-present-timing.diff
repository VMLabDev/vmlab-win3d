+/* Diagnostic present-path timing (n5). D3D10UMD_YTTRIUM_PTIME=<file>. */
+#ifndef YTTRIUM_PTIME_H
+#define YTTRIUM_PTIME_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+enum yttrium_ptime_id {
+   YPT_D3D9_PRESENT,
+   YPT_D3D9_PRESENT_GAP,
+   YPT_D3D9_BLT,
+   YPT_FLUSH_FRONTBUFFER,
+   YPT_ISSUANCE_WAIT,
+   YPT_PRESENT_CB,
+   YPT_DXGI_PRESENT_CB,
+   YPT_FEEDBACK_WAIT,
+   YPT_FEEDBACK_SLEEP1,
+   YPT_RING_SLEEP1,
+   YPT_WORKER_RENDER,
+   YPT_RENDER_CB,
+   YPT_D3D9_LOCK,
+   YPT_D3D9_FLUSH,
+   YPT_COUNT
+};
+uint64_t yttrium_ptime_now(void);
+void yttrium_ptime_add(enum yttrium_ptime_id id, uint64_t start);
+void yttrium_ptime_tick(void);
