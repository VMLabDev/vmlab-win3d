diff --git a/src/gallium/winsys/yttrium/gdi/yttrium_ptime.c b/src/gallium/winsys/yttrium/gdi/yttrium_ptime.c
new file mode 100644
index 0000000..51be90b
--- /dev/null
+++ b/src/gallium/winsys/yttrium/gdi/yttrium_ptime.c
@@ -0,0 +1,103 @@
+/* Diagnostic present-path timing (n5). D3D10UMD_YTTRIUM_PTIME=<file>:
+ * every two seconds each process appends one line per probe with the call
+ * count, mean, max and the count above 8 ms, in milliseconds. */
+#include "yttrium_ptime.h"
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <windows.h>
+
+static const char *const names[YPT_COUNT] = {
+   "d3d9_present", "d3d9_present_gap", "d3d9_blt", "flush_frontbuffer",
+   "issuance_wait", "present_cb", "dxgi_present_cb", "feedback_wait",
+   "feedback_sleep1", "ring_sleep1", "worker_render", "render_cb",
+   "d3d9_lock", "d3d9_flush",
+};
+
+static volatile LONG state; /* 0 unknown, 1 on, 2 off */
+static char path[MAX_PATH];
+static CRITICAL_SECTION lock;
+static double freq_ms;
+static uint64_t last_dump;
+static struct { uint64_t n; double sum, max; uint64_t over8; } s[YPT_COUNT];
+
+static bool
+enabled(void)
+{
+   LONG st = state;
+   if (st)
+      return st == 1;
+   static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+   BOOL pending;
+   InitOnceBeginInitialize(&once, 0, &pending, NULL);
+   if (pending) {
+      DWORD n = GetEnvironmentVariableA("D3D10UMD_YTTRIUM_PTIME", path, sizeof(path));
+      LARGE_INTEGER f;
+      QueryPerformanceFrequency(&f);
+      freq_ms = (double)f.QuadPart / 1000.0;
+      InitializeCriticalSection(&lock);
+      InterlockedExchange(&state, (n && n < sizeof(path)) ? 1 : 2);
+      InitOnceComplete(&once, 0, NULL);
+   }
+   return state == 1;
+}
+
+uint64_t
+yttrium_ptime_now(void)
+{
+   if (!enabled())
+      return 0;
+   LARGE_INTEGER t;
+   QueryPerformanceCounter(&t);
+   return (uint64_t)t.QuadPart;
+}
+
+void
+yttrium_ptime_add(enum yttrium_ptime_id id, uint64_t start)
+{
+   if (!start || !enabled())
+      return;
+   uint64_t now = yttrium_ptime_now();
+   double ms = (double)(now - start) / freq_ms;
+   EnterCriticalSection(&lock);
+   s[id].n++;
+   s[id].sum += ms;
+   if (ms > s[id].max)
+      s[id].max = ms;
+   if (ms > 8.0)
+      s[id].over8++;
+   LeaveCriticalSection(&lock);
+}
+
+void
+yttrium_ptime_tick(void)
+{
+   if (!enabled())
+      return;
+   uint64_t now = yttrium_ptime_now();
+   EnterCriticalSection(&lock);
+   if (!last_dump)
+      last_dump = now;
+   if ((double)(now - last_dump) / freq_ms >= 2000.0) {
+      FILE *f = fopen(path, "a");
+      if (f) {
+         char exe[MAX_PATH] = "";
+         GetModuleFileNameA(NULL, exe, sizeof(exe));
+         const char *base = strrchr(exe, '\\');
+         fprintf(f, "== pid=%lu exe=%s t=%.0f window_ms=%.0f\n", GetCurrentProcessId(),
+                 base ? base + 1 : exe, (double)now / freq_ms,
+                 (double)(now - last_dump) / freq_ms);
+         for (int i = 0; i < YPT_COUNT; i++) {
+            if (!s[i].n)
+               continue;
+            fprintf(f, "%-18s n=%llu mean=%.3f max=%.3f over8=%llu total=%.1f\n", names[i],
+                    (unsigned long long)s[i].n, s[i].sum / s[i].n, s[i].max,
+                    (unsigned long long)s[i].over8, s[i].sum);
+         }
+         fclose(f);
+      }
+      memset(s, 0, sizeof(s));
+      last_dump = now;
+   }
+   LeaveCriticalSection(&lock);
+}
