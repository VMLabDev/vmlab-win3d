import <vmlab.wcl>

// Windows 11 with Venus on the first RTX 5090 (host GPU Nvidia1, renderD128).
// Needs vmlab >= 0.27.0-alpha and a host config (~/.config/vmlab/config.wcl)
// whose gpu "Nvidia1" names the RTX 5090's address and, as qemu_binary, a
// QEMU with the egl-headless fix (patches/host/build-qemu.sh); stock QEMU shows a
// black console on NVIDIA. See docs/nvidia.md.
lab "win3d-nvidia-a" {
  vm "win11" {
    template = "x86_64/windows-11@26100.1742.5"
    secure_boot = false
    gpu {
      mode     = "vulkan"
      host_gpu = "Nvidia1"
    }
  }
}
