import <vmlab.wcl>

// Regression lab for the guest-side NVIDIA fix (patches/mesa/0020): the same
// package on the AMD iGPU (host GPU AMD1, RADV). Plain vmlab >= 0.25.0-alpha,
// no patched host components. See docs/nvidia.md.
lab "win3d-nvidia-amdreg" {
  vm "win11" {
    template = "x86_64/windows-11@26100.1742.5"
    secure_boot = false
    gpu {
      mode     = "vulkan"
      host_gpu = "AMD1"
    }
  }
}
