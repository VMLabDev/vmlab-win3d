+    if (glGetError() != GL_NO_ERROR) {
+        /*
+         * Some drivers (NVIDIA) import some layouts, such as LINEAR, only
+         * as external images.  Import it as one; egl-headless copies it
+         * into a regular texture with a shader before each read-back.
+         */
