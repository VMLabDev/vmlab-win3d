+static GLuint egl_ext_compile(GLenum type, const char *src)
+{
+    GLuint shader = glCreateShader(type);
+    GLint ok;
+
+    glShaderSource(shader, 1, &src, NULL);
+    glCompileShader(shader);
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[512];
+        glGetShaderInfoLog(shader, sizeof(log), NULL, log);
+        error_report("egl-headless: external copy shader: %s", log);
+    }
+    return shader;
+}
+
+/* Draw the external dma-buf texture into guest_fb's own texture, 1:1. */
+static void egl_ext_copy(egl_dpy *edpy)
+{
+    static const char vert[] =
+        "#version 300 es\n"
+        "in vec2 in_position;\n"
+        "out vec2 ex_tex_coord;\n"
+        "void main(void) {\n"
+        "    gl_Position = vec4(in_position, 0.0, 1.0);\n"
+        "    ex_tex_coord = (in_position + 1.0) * 0.5;\n"
+        "}\n";
+    static const char frag[] =
+        "#version 300 es\n"
+        "#extension GL_OES_EGL_image_external_essl3 : require\n"
+        "uniform mediump samplerExternalOES image;\n"
+        "in mediump vec2 ex_tex_coord;\n"
+        "out mediump vec4 out_frag_color;\n"
+        "void main(void) {\n"
+        "    out_frag_color = texture(image, ex_tex_coord);\n"
+        "}\n";
+    static const GLfloat quad[] = { -1, -1, 1, -1, -1, 1, 1, 1 };
+
+    if (!edpy->ext_program) {
+        GLuint vs = egl_ext_compile(GL_VERTEX_SHADER, vert);
+        GLuint fs = egl_ext_compile(GL_FRAGMENT_SHADER, frag);
+
+        edpy->ext_program = glCreateProgram();
+        glAttachShader(edpy->ext_program, vs);
+        glAttachShader(edpy->ext_program, fs);
+        glBindAttribLocation(edpy->ext_program, 0, "in_position");
+        glLinkProgram(edpy->ext_program);
+
+        glDeleteShader(vs);
+        glDeleteShader(fs);
+        glGenBuffers(1, &edpy->ext_vbo);
+        glBindBuffer(GL_ARRAY_BUFFER, edpy->ext_vbo);
+        glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_STATIC_DRAW);
+    }
+
+    /*
+     * A core profile context draws only with a vertex array object, and
+     * vertex array objects are not shared between contexts: the context
+     * current here changes (virgl resets on guest reboot), so use a fresh one.
+     */
+    GLuint vao;
+    glGenVertexArrays(1, &vao);
+    glBindVertexArray(vao);
+    glBindBuffer(GL_ARRAY_BUFFER, edpy->ext_vbo);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, 0);
+
+    glBindFramebuffer(GL_FRAMEBUFFER_EXT, edpy->guest_fb.framebuffer);
+    glViewport(0, 0, edpy->guest_fb.width, edpy->guest_fb.height);
+    glUseProgram(edpy->ext_program);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_EXTERNAL_OES, edpy->ext_texture);
+    glUniform1i(glGetUniformLocation(edpy->ext_program, "image"), 0);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+
+    glBindVertexArray(0);
+    glDeleteVertexArrays(1, &vao);
+    glUseProgram(0);
+}
