diff --git a/src/venus/vkr_image.c b/src/venus/vkr_image.c
index 20ba57a..6c42d4d 100644
--- a/src/venus/vkr_image.c
+++ b/src/venus/vkr_image.c
@@ -86,7 +86,29 @@ vkr_dispatch_vkCreateImage(struct vn_dispatch_context *dispatch,
     * situation because the app does not consider the memory external.
     */
 
+   /* vkr_image_create_and_add replaces args->device with the driver handle */
+   const VkDevice device = args->device;
    struct vkr_image *img = vkr_image_create_and_add(dispatch->data, args);
+
+   /* vmlab-win3d: some drivers (NVIDIA 610) reject
+    * VK_IMAGE_USAGE_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT on linear images with
+    * VK_ERROR_FORMAT_NOT_SUPPORTED.  Guests that create images without a
+    * reply (Yttrium's venus2 winsys) never see the error and go on to use
+    * an image the renderer does not have, which is a fatal CS error.  The
+    * usage bit only allows the ATTACHMENT_FEEDBACK_LOOP_OPTIMAL layout, so
+    * retry without it rather than lose the context.
+    */
+   if (!img && args->ret == VK_ERROR_FORMAT_NOT_SUPPORTED &&
+       (args->pCreateInfo->usage & VK_IMAGE_USAGE_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT)) {
+      VkImageCreateInfo *info = (VkImageCreateInfo *)args->pCreateInfo;
+      info->usage &= ~VK_IMAGE_USAGE_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT;
+      args->device = device;
+      img = vkr_image_create_and_add(dispatch->data, args);
+      if (img && args->ret == VK_SUCCESS)
+         vkr_log_image_create_info("vkCreateImage retried without feedback-loop usage",
+                                   args->ret, args->pCreateInfo);
+   }
+
    if (!img || args->ret != VK_SUCCESS)
       vkr_log_image_create_info("vkCreateImage failed", args->ret, args->pCreateInfo);
    else if (getenv("VKR_LOG_IMAGES"))
diff --git a/src/venus/vkr_physical_device.c b/src/venus/vkr_physical_device.c
index e2c3baa..a4c1c98 100644
--- a/src/venus/vkr_physical_device.c
+++ b/src/venus/vkr_physical_device.c
@@ -610,6 +610,15 @@ vkr_dispatch_vkGetPhysicalDeviceImageFormatProperties(
    args->ret = vk->GetPhysicalDeviceImageFormatProperties(
       args->physicalDevice, args->format, args->type, args->tiling, args->usage,
       args->flags, args->pImageFormatProperties);
+
+   /* vmlab-win3d: see vkr_dispatch_vkGetPhysicalDeviceImageFormatProperties2 */
+   if (args->ret == VK_ERROR_FORMAT_NOT_SUPPORTED &&
+       (args->usage & VK_IMAGE_USAGE_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT)) {
+      args->usage &= ~VK_IMAGE_USAGE_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT;
+      args->ret = vk->GetPhysicalDeviceImageFormatProperties(
+         args->physicalDevice, args->format, args->type, args->tiling, args->usage,
+         args->flags, args->pImageFormatProperties);
+   }
 }
 
 static void
@@ -715,6 +724,19 @@ vkr_dispatch_vkGetPhysicalDeviceImageFormatProperties2(
    vn_replace_vkGetPhysicalDeviceImageFormatProperties2_args_handle(args);
    args->ret = vk->GetPhysicalDeviceImageFormatProperties2(
       args->physicalDevice, args->pImageFormatInfo, args->pImageFormatProperties);
+
+   /* vmlab-win3d: answer as vkr_dispatch_vkCreateImage will create the
+    * image, without VK_IMAGE_USAGE_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT when the
+    * driver rejects it (NVIDIA 610 on linear images).
+    */
+   if (args->ret == VK_ERROR_FORMAT_NOT_SUPPORTED &&
+       (args->pImageFormatInfo->usage & VK_IMAGE_USAGE_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT)) {
+      VkPhysicalDeviceImageFormatInfo2 *info =
+         (VkPhysicalDeviceImageFormatInfo2 *)args->pImageFormatInfo;
+      info->usage &= ~VK_IMAGE_USAGE_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT;
+      args->ret = vk->GetPhysicalDeviceImageFormatProperties2(
+         args->physicalDevice, args->pImageFormatInfo, args->pImageFormatProperties);
+   }
 }
 
