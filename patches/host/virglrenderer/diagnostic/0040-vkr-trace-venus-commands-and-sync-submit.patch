Subject: [PATCH] vkr: record the Venus command stream and wait on every submission (diagnostics)

Diagnostics only; not applied by patches/host/build-virglrenderer.sh.
Applies on 1.3.0 after 0001 and 0002.

- VKR_TRACE=<dir> writes every Venus command a context dispatches, as the
  guest encoded it, to <dir>/vkr-<pid>.bin (one render-server process per
  context). VKR_TRACE_APP=<a|b|...> limits it to contexts whose guest
  process or application name contains one of the substrings.
  docs/evidence/godot/tools/vkr-trace-dump.py prints a trace.
- VKR_SYNC_SUBMIT=1 (traced contexts only) waits for the queue after every
  vkQueueSubmit and vkQueueSubmit2 and logs the result with the guest ids
  of the submitted command buffers, so the submission that loses the
  device is named.

Used to find the Godot Xid 69 (docs/godot.md).
Origin: vmlab-win3d godot worker.
---
diff --git a/src/meson.build b/src/meson.build
index 138301c..6a6177f 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -83,6 +83,7 @@ venus_sources = [
    'venus/vkr_renderer.c',
    'venus/vkr_ring.c',
    'venus/vkr_transport.c',
+   'venus/vkr_trace.c',
 ]
 
 venus_codegen = custom_target(
diff --git a/src/venus/venus-protocol/vn_protocol_renderer_dispatches.h b/src/venus/venus-protocol/vn_protocol_renderer_dispatches.h
index e138f6d..7af463f 100644
--- a/src/venus/venus-protocol/vn_protocol_renderer_dispatches.h
+++ b/src/venus/venus-protocol/vn_protocol_renderer_dispatches.h
@@ -700,10 +700,14 @@ static void (*const vn_dispatch_table[335])(struct vn_dispatch_context *ctx, VkC
     [VK_COMMAND_TYPE_vkCopyMemoryToImageMESA_EXT] = vn_dispatch_vkCopyMemoryToImageMESA,
 };
 
+const void *vkr_trace_cmd_begin(struct vn_dispatch_context *ctx);
+void vkr_trace_cmd_end(struct vn_dispatch_context *ctx, const void *begin, uint32_t cmd_type);
+
 static inline void vn_dispatch_command(struct vn_dispatch_context *ctx)
 {
     VkCommandTypeEXT cmd_type;
     VkCommandFlagsEXT cmd_flags;
+    const void *trace_begin = vkr_trace_cmd_begin(ctx);
 
     vn_decode_VkCommandTypeEXT(ctx->decoder, &cmd_type);
     vn_decode_VkFlags(ctx->decoder, &cmd_flags);
@@ -715,6 +719,9 @@ static inline void vn_dispatch_command(struct vn_dispatch_context *ctx)
             vn_cs_decoder_set_fatal(ctx->decoder);
     }
 
+    if (trace_begin)
+        vkr_trace_cmd_end(ctx, trace_begin, cmd_type);
+
     if (vn_cs_decoder_get_fatal(ctx->decoder))
         vn_dispatch_debug_log(ctx, "%s resulted in CS error", vn_dispatch_command_name(cmd_type));
 }
diff --git a/src/venus/vkr_queue.c b/src/venus/vkr_queue.c
index ed21bf3..53d11ab 100644
--- a/src/venus/vkr_queue.c
+++ b/src/venus/vkr_queue.c
@@ -10,6 +10,35 @@
 #include "vkr_context.h"
 #include "vkr_physical_device.h"
 #include "vkr_queue_gen.h"
+#include "vkr_command_buffer.h"
+
+void vkr_trace_note(const char *fmt, ...);
+bool vkr_trace_active(void);
+
+/* Diagnostics only: VKR_SYNC_SUBMIT=1 waits for every queue submission and
+ * logs its result with the guest ids of its command buffers. */
+static bool
+vkr_sync_submit(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *v = getenv("VKR_SYNC_SUBMIT");
+      on = v && *v == '1';
+   }
+   return on && vkr_trace_active();
+}
+
+static void
+vkr_sync_submit_wait(struct vn_device_proc_table *vk, VkQueue queue, VkResult submit_ret,
+                     const char *what, const char *cbs)
+{
+   static uint64_t seq;
+   VkResult r = submit_ret == VK_SUCCESS ? vk->QueueWaitIdle(queue) : submit_ret;
+   seq++;
+   if (r != VK_SUCCESS || (seq % 500) == 0 || seq < 50)
+      vkr_trace_note("sync-submit %" PRIu64 " %s ret=%d wait=%d cbs=%s", seq, what,
+                     submit_ret, r, cbs);
+}
 
 static struct vkr_queue_sync *
 vkr_device_alloc_queue_sync(struct vkr_device *dev,
@@ -373,11 +402,22 @@ vkr_dispatch_vkQueueSubmit(UNUSED struct vn_dispatch_context *dispatch,
    struct vkr_queue *queue = vkr_queue_from_handle(args->queue);
    struct vn_device_proc_table *vk = &queue->device->proc_table;
 
+   char cbs[512] = "";
+   if (vkr_sync_submit()) {
+      size_t n = 0;
+      for (uint32_t i = 0; i < args->submitCount; i++)
+         for (uint32_t j = 0; j < args->pSubmits[i].commandBufferCount && n < sizeof(cbs) - 24; j++)
+            n += snprintf(cbs + n, sizeof(cbs) - n, "%s%" PRIu64, n ? "," : "",
+                          ((struct vkr_command_buffer *)args->pSubmits[i].pCommandBuffers[j])->base.id);
+   }
+
    vn_replace_vkQueueSubmit_args_handle(args);
 
    mtx_lock(&queue->vk_mutex);
    args->ret =
       vk->QueueSubmit(args->queue, args->submitCount, args->pSubmits, args->fence);
+   if (vkr_sync_submit())
+      vkr_sync_submit_wait(vk, args->queue, args->ret, "submit", cbs);
    mtx_unlock(&queue->vk_mutex);
 }
 
@@ -414,11 +454,22 @@ vkr_dispatch_vkQueueSubmit2(UNUSED struct vn_dispatch_context *dispatch,
    struct vkr_queue *queue = vkr_queue_from_handle(args->queue);
    struct vn_device_proc_table *vk = &queue->device->proc_table;
 
+   char cbs[512] = "";
+   if (vkr_sync_submit()) {
+      size_t n = 0;
+      for (uint32_t i = 0; i < args->submitCount; i++)
+         for (uint32_t j = 0; j < args->pSubmits[i].commandBufferInfoCount && n < sizeof(cbs) - 24; j++)
+            n += snprintf(cbs + n, sizeof(cbs) - n, "%s%" PRIu64, n ? "," : "",
+                          ((struct vkr_command_buffer *)args->pSubmits[i].pCommandBufferInfos[j].commandBuffer)->base.id);
+   }
+
    vn_replace_vkQueueSubmit2_args_handle(args);
 
    mtx_lock(&queue->vk_mutex);
    args->ret =
       vk->QueueSubmit2(args->queue, args->submitCount, args->pSubmits, args->fence);
+   if (vkr_sync_submit())
+      vkr_sync_submit_wait(vk, args->queue, args->ret, "submit2", cbs);
    mtx_unlock(&queue->vk_mutex);
 }
 
diff --git a/src/venus/vkr_trace.c b/src/venus/vkr_trace.c
new file mode 100644
index 0000000..2be8159
--- /dev/null
+++ b/src/venus/vkr_trace.c
@@ -0,0 +1,146 @@
+/*
+ * Diagnostics only: VKR_TRACE=<dir> records every Venus command this render
+ * server dispatches, as the guest encoded it, into <dir>/vkr-<pid>.bin.
+ * Record: u32 size, u32 cmd_type, u64 tag (dispatch context), u64 ns, bytes.
+ * cmd_type 0xffffffff is a text marker (submit results with VKR_SYNC_SUBMIT).
+ */
+#include "vkr_common.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "vkr_context.h"
+#include "vkr_cs.h"
+#include "venus-protocol/vn_protocol_renderer_dispatches.h"
+
+void vkr_trace_note(const char *fmt, ...);
+
+static once_flag trace_once = ONCE_FLAG_INIT;
+static FILE *trace_file;
+static mtx_t trace_mutex;
+/* VKR_TRACE_APP=<substring>: trace only a context whose guest process or
+ * application name contains it. -1 undecided, 0 no, 1 yes. */
+static int trace_decided = -1;
+
+static bool
+trace_match(const char *name, const char *want)
+{
+   if (!name)
+      return false;
+   char buf[256];
+   snprintf(buf, sizeof(buf), "%s", want);
+   for (char *save = NULL, *tok = strtok_r(buf, "|", &save); tok; tok = strtok_r(NULL, "|", &save)) {
+      if (strstr(name, tok))
+         return true;
+   }
+   return false;
+}
+
+static void
+trace_init(void)
+{
+   mtx_init(&trace_mutex, mtx_plain);
+}
+
+static void
+trace_open(void)
+{
+   const char *dir = getenv("VKR_TRACE");
+   if (!dir || !*dir)
+      return;
+   char path[512];
+   snprintf(path, sizeof(path), "%s/vkr-%d.bin", dir, (int)getpid());
+   trace_file = fopen(path, "wb");
+   if (trace_file)
+      vkr_log("tracing Venus commands to %s", path);
+}
+
+static uint64_t
+trace_now(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+static void
+trace_write(uint32_t type, uint64_t tag, const void *data, uint32_t size)
+{
+   const uint64_t now = trace_now();
+   mtx_lock(&trace_mutex);
+   fwrite(&size, 4, 1, trace_file);
+   fwrite(&type, 4, 1, trace_file);
+   fwrite(&tag, 8, 1, trace_file);
+   fwrite(&now, 8, 1, trace_file);
+   fwrite(data, 1, size, trace_file);
+   mtx_unlock(&trace_mutex);
+}
+
+const void *
+vkr_trace_cmd_begin(struct vn_dispatch_context *ctx)
+{
+   call_once(&trace_once, trace_init);
+   if (trace_decided < 0) {
+      const struct vkr_context *vctx = ctx->data;
+      const char *want = getenv("VKR_TRACE_APP");
+      if (!getenv("VKR_TRACE")) {
+         trace_decided = 0;
+      } else if (!want || !*want || trace_match(vctx->debug_name, want) ||
+                 trace_match(vctx->instance_name, want)) {
+         trace_decided = 1;
+         vkr_log("tracing context %s / %s", vctx->debug_name,
+                 vctx->instance_name ? vctx->instance_name : "-");
+         trace_open();
+      } else if (vctx->instance) {
+         vkr_log("not tracing context %s / %s", vctx->debug_name,
+                 vctx->instance_name ? vctx->instance_name : "-");
+         trace_decided = 0;
+      }
+   }
+   if (!trace_file)
+      return NULL;
+   return ((struct vkr_cs_decoder *)ctx->decoder)->cur;
+}
+
+void
+vkr_trace_cmd_end(struct vn_dispatch_context *ctx, const void *begin, uint32_t cmd_type)
+{
+   if (!trace_file || !begin || cmd_type == VK_COMMAND_TYPE_vkExecuteCommandStreamsMESA_EXT)
+      return;
+   const uint8_t *end = ((struct vkr_cs_decoder *)ctx->decoder)->cur;
+   if (!end || end <= (const uint8_t *)begin || end - (const uint8_t *)begin > (64 << 20))
+      return;
+   trace_write(cmd_type, (uint64_t)(uintptr_t)ctx, begin, end - (const uint8_t *)begin);
+}
+
+void
+vkr_trace_note(const char *fmt, ...)
+{
+   call_once(&trace_once, trace_init);
+   char msg[1024];
+   va_list va;
+   va_start(va, fmt);
+   int n = vsnprintf(msg, sizeof(msg), fmt, va);
+   va_end(va);
+   if (n < 0)
+      return;
+   if (n >= (int)sizeof(msg))
+      n = sizeof(msg) - 1;
+   vkr_log("%s", msg);
+   if (!trace_file)
+      return;
+   trace_write(0xffffffffu, 0, msg, n);
+   mtx_lock(&trace_mutex);
+   fflush(trace_file);
+   mtx_unlock(&trace_mutex);
+}
+
+bool vkr_trace_active(void);
+
+bool
+vkr_trace_active(void)
+{
+   return trace_decided == 1;
+}
