+   struct vkr_image *img = vkr_image_create_and_add(dispatch->data, args);
+   if (!img || args->ret != VK_SUCCESS)
+      vkr_log_image_create_info("vkCreateImage failed", args->ret, args->pCreateInfo);
+   else if (getenv("VKR_LOG_IMAGES"))
+      vkr_log_image_create_info("vkCreateImage", args->ret, args->pCreateInfo);
 }
 
