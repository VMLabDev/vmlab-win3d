+    * vertex buffer whole with both, about 100 times a second. */
+   if (buffer_resource && data->Flags.Discard && data->Flags.NoOverwrite)
+      usage &= ~PIPE_MAP_DISCARD_RANGE;
    void *map = NULL;
 
    if (buffer_resource) {
@@ -3381,6 +3352,8 @@ D3D9Lock(HANDLE hDevice, D3DDDIARG_LOCK *data)
       data->SlicePitch = 0;
       if (sub->transfer) {
          sub->transfer_write = (usage & PIPE_MAP_WRITE) != 0;
