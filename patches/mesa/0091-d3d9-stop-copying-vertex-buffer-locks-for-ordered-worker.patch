-      if (sub->transfer_write && resource->flags.VertexBuffer &&
-          D3D9OrderedContextWorkerEnabled())
-         worker_upload_ok = D3D9CaptureWorkerBufferUpload(device, sub);
+      /* With the ordered context worker, queued draws read the buffer when
+       * the worker records them. A DISCARD lock needs nothing: the threaded
+       * context stages it in new memory and copies it into the buffer in
