+   if (!cs)
+      return;
+   if (cs->compute_emulation == COMPUTE_EMULATION_NONE && cs->handle) {
+      if (args->resource->target != PIPE_BUFFER ||
+          (AlignedByteOffsetForArgs & 3) ||
+          AlignedByteOffsetForArgs > args->resource->width0 ||
+          sizeof(dispatch_args) > args->resource->width0 - AlignedByteOffsetForArgs)
