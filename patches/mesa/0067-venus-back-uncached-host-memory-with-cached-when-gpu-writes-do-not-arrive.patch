diff --git a/src/virtio/vulkan/vn_device_memory.c b/src/virtio/vulkan/vn_device_memory.c
index 5487eb2..d2c0c37 100644
--- a/src/virtio/vulkan/vn_device_memory.c
+++ b/src/virtio/vulkan/vn_device_memory.c
@@ -417,6 +417,35 @@ vn_device_memory_alloc(struct vn_device *dev,
    const VkMemoryType *mem_type = &dev->physical_device->memory_properties
                                       .memoryTypes[mem_vk->memory_type_index];
 
+   /* Back an uncached host-visible type whose host GPU writes do not reach
+    * the guest with its cached counterpart (vn_feedback_self_test), unless
+    * the memory is exported or dedicated to a resource that cannot use it.
+    */
+   VkMemoryAllocateInfo remapped_info;
+   const uint32_t remap = dev->mem_type_remap[mem_vk->memory_type_index];
+   if (remap != mem_vk->memory_type_index && !mem_vk->export_handle_types) {
+      const VkMemoryDedicatedAllocateInfo *dedicated =
+         vk_find_struct_const(alloc_info->pNext, MEMORY_DEDICATED_ALLOCATE_INFO);
+      uint32_t type_bits = ~0u;
+      if (dedicated && dedicated->buffer != VK_NULL_HANDLE) {
+         type_bits = vn_buffer_from_handle(dedicated->buffer)
+                        ->requirements.memory.memoryRequirements.memoryTypeBits;
+      } else if (dedicated && dedicated->image != VK_NULL_HANDLE) {
+         const struct vn_image *img = vn_image_from_handle(dedicated->image);
+         type_bits = img->deferred_info
+                        ? 0
+                        : img->requirements[0]
+                             .memory.memoryRequirements.memoryTypeBits;
+      }
+      if (type_bits & (1u << remap)) {
+         remapped_info = *alloc_info;
+         remapped_info.memoryTypeIndex = remap;
+         alloc_info = &remapped_info;
+         mem_vk->memory_type_index = remap;
+         mem_type = &dev->physical_device->memory_properties.memoryTypes[remap];
+      }
+   }
+
    const bool has_guest_vram = dev->renderer->info.has_guest_vram;
    const bool host_visible =
       mem_type->propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
