-/* Checks once per device that a feedback write by the host GPU reaches the
- * guest: one fence feedback command, submitted and waited for through the
- * renderer, must leave its slot signalled. A host whose GPU writes do not
- * become visible in the guest's mapping of the feedback buffer would
- * otherwise hang every fence and timeline semaphore wait (the guest keeps
- * reading the status it wrote itself; docs/nvfb.md). On failure feedback is
- * disabled for the device, which costs a renderer round trip per status
- * check but stays correct. On a good host this is one submission and a
- * fence wait at device creation.
+/* An uncached host-visible type whose host GPU writes are checked at device
+ * creation, and the cached type that backs it if they do not arrive.
+ */
+struct vn_host_write_check {
+   uint32_t type;
+   uint32_t cached_type;
+   VkBuffer buf;
+   VkDeviceMemory mem;
+   volatile uint32_t *ptr;
+   VkCommandBuffer cmd;
+};
+
+#define VN_HOST_WRITE_CHECK_VALUE 0x6e766662u /* "nvfb" */
+
+static uint32_t
+vn_find_cached_superset_type(const VkPhysicalDeviceMemoryProperties *props,
+                             uint32_t type)
+{
+   const VkMemoryPropertyFlags want =
+      props->memoryTypes[type].propertyFlags |
+      VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
+   for (uint32_t i = 0; i < props->memoryTypeCount; i++) {
+      if (props->memoryTypes[i].heapIndex == props->memoryTypes[type].heapIndex &&
+          (props->memoryTypes[i].propertyFlags & want) == want &&
+          !(props->memoryTypes[i].propertyFlags &
+            VK_MEMORY_PROPERTY_PROTECTED_BIT))
+         return i;
+   }
+   return UINT32_MAX;
+}
+
+/* Sets up a 4 KiB buffer in an uncached HOST_COHERENT type and a command
+ * buffer that fills its first word on the GPU. The CPU writes and reads
+ * the word first, as an application that maps the memory would.
+ */
+static bool
+vn_host_write_check_init(struct vn_device *dev,
+                         VkCommandPool pool_handle,
+                         struct vn_host_write_check *check)
+{
+   VkDevice dev_handle = vn_device_to_handle(dev);
+
+   const VkBufferCreateInfo buf_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = 4096,
+      .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   if (vn_CreateBuffer(dev_handle, &buf_info, NULL, &check->buf) !=
+       VK_SUCCESS)
+      return false;
+
+   const struct vn_buffer *buf = vn_buffer_from_handle(check->buf);
+   const VkMemoryRequirements *reqs =
+      &buf->requirements.memory.memoryRequirements;
+   const uint32_t both = (1u << check->type) | (1u << check->cached_type);
+   if ((reqs->memoryTypeBits & both) != both)
+      goto fail_buf;
+
+   const VkMemoryAllocateInfo alloc_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = reqs->size,
+      .memoryTypeIndex = check->type,
+   };
+   if (vn_AllocateMemory(dev_handle, &alloc_info, NULL, &check->mem) !=
+       VK_SUCCESS)
+      goto fail_buf;
+   const VkBindBufferMemoryInfo bind_info = {
+      .sType = VK_STRUCTURE_TYPE_BIND_BUFFER_MEMORY_INFO,
+      .buffer = check->buf,
+      .memory = check->mem,
+   };
+   void *ptr;
+   const VkMemoryMapInfo map_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_MAP_INFO,
+      .memory = check->mem,
+      .size = VK_WHOLE_SIZE,
+   };
+   if (vn_BindBufferMemory2(dev_handle, 1, &bind_info) != VK_SUCCESS ||
+       vn_MapMemory2(dev_handle, &map_info, &ptr) != VK_SUCCESS)
+      goto fail_mem;
+   check->ptr = ptr;
+   *check->ptr = 0;
+   (void)*check->ptr;
+
+   const VkCommandBufferAllocateInfo cmd_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool_handle,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   if (vn_AllocateCommandBuffers(dev_handle, &cmd_info, &check->cmd) !=
+       VK_SUCCESS)
+      goto fail_map;
+   const VkCommandBufferBeginInfo begin_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+   };
+   if (vn_BeginCommandBuffer(check->cmd, &begin_info) != VK_SUCCESS)
+      goto fail_cmd;
+   vn_CmdFillBuffer(check->cmd, check->buf, 0, 4, VN_HOST_WRITE_CHECK_VALUE);
+   vn_feedback_cmd_record_flush_barrier(check->cmd, check->buf, 0, 4);
+   if (vn_EndCommandBuffer(check->cmd) != VK_SUCCESS)
+      goto fail_cmd;
+
+   return true;
+
+fail_cmd:
+   vn_FreeCommandBuffers(dev_handle, pool_handle, 1, &check->cmd);
+fail_map:
+   vn_UnmapMemory2(dev_handle, &(VkMemoryUnmapInfo){
+                                  .sType = VK_STRUCTURE_TYPE_MEMORY_UNMAP_INFO,
+                                  .memory = check->mem,
+                               });
+fail_mem:
+   vn_FreeMemory(dev_handle, check->mem, NULL);
+fail_buf:
+   vn_DestroyBuffer(dev_handle, check->buf, NULL);
+   return false;
+}
+
+static void
+vn_host_write_check_fini(struct vn_device *dev,
+                         VkCommandPool pool_handle,
+                         struct vn_host_write_check *check)
+{
+   VkDevice dev_handle = vn_device_to_handle(dev);
+
+   vn_FreeCommandBuffers(dev_handle, pool_handle, 1, &check->cmd);
+   vn_UnmapMemory2(dev_handle, &(VkMemoryUnmapInfo){
+                                  .sType = VK_STRUCTURE_TYPE_MEMORY_UNMAP_INFO,
+                                  .memory = check->mem,
+                               });
+   vn_FreeMemory(dev_handle, check->mem, NULL);
+   vn_DestroyBuffer(dev_handle, check->buf, NULL);
+}
+
+/* Checks once per device that writes by the host GPU reach the guest:
+ *
+ * - One fence feedback command must leave its slot signalled. A host whose
+ *   GPU writes do not become visible in the guest's mapping of the
+ *   feedback buffer would otherwise hang every fence and timeline
+ *   semaphore wait (the guest keeps reading the status it wrote itself;
+ *   docs/nvfb.md). On failure feedback is disabled for the device, which
+ *   costs a renderer round trip per status check but stays correct.
+ * - A fill of a buffer in each uncached HOST_COHERENT type that has a
+ *   host-cached counterpart (same heap, superset of flags) must be visible.
+ *   On the RTX 4060 Laptop host it is not, so a readback through that
+ *   type reads stale data. On failure, the device backs allocations of
+ *   that type with the cached type (vn_device_memory_alloc).
+ *
+ * The commands go in one submission, waited for through the renderer with
+ * a fence that has no feedback of its own (the renderer refuses the
+ * blocking vkQueueWaitIdle), repeated up to three times while every write
+ * arrives.
  */
