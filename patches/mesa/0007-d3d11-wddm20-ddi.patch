+#if SUPPORT_D3D_WDDM2_0
+static bool
+ValidPlaneWDDM2_0(D3D10DDI_HDEVICE hDevice, DXGI_FORMAT format, UINT plane)
+{
+   const bool stencil = format == DXGI_FORMAT_X24_TYPELESS_G8_UINT ||
+                        format == DXGI_FORMAT_X32_TYPELESS_G8X24_UINT;
+   if (plane > 1 || (plane && !stencil)) {
+      SetError(hDevice, E_INVALIDARG);
+      return false;
+   }
+   return true;
+}
+
+static bool
+SupportsTypedLoadsWDDM2_0(struct pipe_screen *screen)
+{
+   const enum pipe_format required[] = {
+      PIPE_FORMAT_R32G32B32A32_FLOAT,
+      PIPE_FORMAT_R32G32B32A32_UINT,
+      PIPE_FORMAT_R32G32B32A32_SINT,
+      PIPE_FORMAT_R16G16B16A16_FLOAT,
+      PIPE_FORMAT_R16G16B16A16_UINT,
+      PIPE_FORMAT_R16G16B16A16_SINT,
+      PIPE_FORMAT_R8G8B8A8_UNORM,
+      PIPE_FORMAT_R8G8B8A8_UINT,
+      PIPE_FORMAT_R8G8B8A8_SINT,
+      PIPE_FORMAT_R16_FLOAT,
+      PIPE_FORMAT_R16_UINT,
+      PIPE_FORMAT_R16_SINT,
+      PIPE_FORMAT_R8_UNORM,
+      PIPE_FORMAT_R8_UINT,
+      PIPE_FORMAT_R8_SINT,
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(required); ++i) {
+      if (!yttrium_gdi_screen_supports_typed_image_load(screen, required[i]))
+         return false;
+   }
+   return true;
+}
+
+static D3D11DDIARG_CREATESHADERRESOURCEVIEW
+ConvertShaderViewWDDM2_0(const D3DWDDM2_0DDIARG_CREATESHADERRESOURCEVIEW *source)
+{
+   D3D11DDIARG_CREATESHADERRESOURCEVIEW dest = {};
+   dest.hDrvResource = source->hDrvResource;
+   dest.Format = source->Format;
+   dest.ResourceDimension = source->ResourceDimension;
+   switch (source->ResourceDimension) {
+   case D3D10DDIRESOURCE_BUFFER: dest.Buffer = source->Buffer; break;
+   case D3D11DDIRESOURCE_BUFFEREX: dest.BufferEx = source->BufferEx; break;
+   case D3D10DDIRESOURCE_TEXTURE1D: dest.Tex1D = source->Tex1D; break;
+   case D3D10DDIRESOURCE_TEXTURE2D:
+      dest.Tex2D = {source->Tex2D.MostDetailedMip, source->Tex2D.FirstArraySlice,
+                   source->Tex2D.MipLevels, source->Tex2D.ArraySize};
+      break;
+   case D3D10DDIRESOURCE_TEXTURE3D: dest.Tex3D = source->Tex3D; break;
+   case D3D10DDIRESOURCE_TEXTURECUBE: dest.TexCube = source->TexCube; break;
+   default: break;
+   }
+   return dest;
+}
+
+static SIZE_T APIENTRY
+CalcPrivateShaderResourceViewSizeWDDM2_0(D3D10DDI_HDEVICE device,
+   const D3DWDDM2_0DDIARG_CREATESHADERRESOURCEVIEW *source)
+{
+   auto desc = ConvertShaderViewWDDM2_0(source);
+   return CalcPrivateShaderResourceViewSize11(device, &desc);
+}
+
+static void APIENTRY
+CreateShaderResourceViewWDDM2_0(D3D10DDI_HDEVICE device,
+   const D3DWDDM2_0DDIARG_CREATESHADERRESOURCEVIEW *source,
+   D3D10DDI_HSHADERRESOURCEVIEW view, D3D10DDI_HRTSHADERRESOURCEVIEW rtView)
+{
+   if (source->ResourceDimension == D3D10DDIRESOURCE_TEXTURE2D &&
+       !ValidPlaneWDDM2_0(device, source->Format, source->Tex2D.PlaneSlice))
+      return;
+   auto desc = ConvertShaderViewWDDM2_0(source);
+   CreateShaderResourceView11(device, &desc, view, rtView);
+}
+
+static D3D10DDIARG_CREATERENDERTARGETVIEW
+ConvertRenderViewWDDM2_0(const D3DWDDM2_0DDIARG_CREATERENDERTARGETVIEW *source)
+{
+   D3D10DDIARG_CREATERENDERTARGETVIEW dest = {};
+   dest.hDrvResource = source->hDrvResource;
+   dest.Format = source->Format;
+   dest.ResourceDimension = source->ResourceDimension;
+   switch (source->ResourceDimension) {
+   case D3D10DDIRESOURCE_BUFFER: dest.Buffer = source->Buffer; break;
+   case D3D10DDIRESOURCE_TEXTURE1D: dest.Tex1D = source->Tex1D; break;
+   case D3D10DDIRESOURCE_TEXTURE2D:
+      dest.Tex2D = {source->Tex2D.MipSlice, source->Tex2D.FirstArraySlice,
+                   source->Tex2D.ArraySize};
+      break;
+   case D3D10DDIRESOURCE_TEXTURE3D: dest.Tex3D = source->Tex3D; break;
+   case D3D10DDIRESOURCE_TEXTURECUBE: dest.TexCube = source->TexCube; break;
+   default: break;
+   }
+   return dest;
+}
+
+static SIZE_T APIENTRY
+CalcPrivateRenderTargetViewSizeWDDM2_0(D3D10DDI_HDEVICE device,
+   const D3DWDDM2_0DDIARG_CREATERENDERTARGETVIEW *source)
+{
+   auto desc = ConvertRenderViewWDDM2_0(source);
+   return CalcPrivateRenderTargetViewSize(device, &desc);
+}
+
+static void APIENTRY
+CreateRenderTargetViewWDDM2_0(D3D10DDI_HDEVICE device,
+   const D3DWDDM2_0DDIARG_CREATERENDERTARGETVIEW *source,
+   D3D10DDI_HRENDERTARGETVIEW view, D3D10DDI_HRTRENDERTARGETVIEW rtView)
+{
+   if (source->ResourceDimension == D3D10DDIRESOURCE_TEXTURE2D &&
+       !ValidPlaneWDDM2_0(device, source->Format, source->Tex2D.PlaneSlice))
+      return;
+   auto desc = ConvertRenderViewWDDM2_0(source);
+   CreateRenderTargetView(device, &desc, view, rtView);
+}
+
+static D3D11DDIARG_CREATEUNORDEREDACCESSVIEW
+ConvertUnorderedViewWDDM2_0(const D3DWDDM2_0DDIARG_CREATEUNORDEREDACCESSVIEW *source)
+{
+   D3D11DDIARG_CREATEUNORDEREDACCESSVIEW dest = {};
+   dest.hDrvResource = source->hDrvResource;
+   dest.Format = source->Format;
+   dest.ResourceDimension = source->ResourceDimension;
+   switch (source->ResourceDimension) {
+   case D3D10DDIRESOURCE_BUFFER: dest.Buffer = source->Buffer; break;
+   case D3D10DDIRESOURCE_TEXTURE1D: dest.Tex1D = source->Tex1D; break;
+   case D3D10DDIRESOURCE_TEXTURE2D:
+      dest.Tex2D = {source->Tex2D.MipSlice, source->Tex2D.FirstArraySlice,
+                   source->Tex2D.ArraySize};
+      break;
+   case D3D10DDIRESOURCE_TEXTURE3D: dest.Tex3D = source->Tex3D; break;
+   default: break;
+   }
+   return dest;
+}
+
+static SIZE_T APIENTRY
+CalcPrivateUnorderedAccessViewSizeWDDM2_0(D3D10DDI_HDEVICE device,
+   const D3DWDDM2_0DDIARG_CREATEUNORDEREDACCESSVIEW *source)
+{
+   auto desc = ConvertUnorderedViewWDDM2_0(source);
+   return CalcPrivateUnorderedAccessViewSize(device, &desc);
+}
+
+static void APIENTRY
+CreateUnorderedAccessViewWDDM2_0(D3D10DDI_HDEVICE device,
+   const D3DWDDM2_0DDIARG_CREATEUNORDEREDACCESSVIEW *source,
+   D3D11DDI_HUNORDEREDACCESSVIEW view, D3D11DDI_HRTUNORDEREDACCESSVIEW rtView)
+{
+   if (source->ResourceDimension == D3D10DDIRESOURCE_TEXTURE2D &&
+       !ValidPlaneWDDM2_0(device, source->Format, source->Tex2D.PlaneSlice))
+      return;
+   auto desc = ConvertUnorderedViewWDDM2_0(source);
+   CreateUnorderedAccessView(device, &desc, view, rtView);
+}
+
+static SIZE_T APIENTRY
+CalcPrivateRasterizerStateSizeWDDM2_0(D3D10DDI_HDEVICE device,
+   const D3DWDDM2_0DDI_RASTERIZER_DESC *source)
+{
+   D3D11_1_DDI_RASTERIZER_DESC desc;
+   static_assert(sizeof(desc) ==
+                 offsetof(D3DWDDM2_0DDI_RASTERIZER_DESC, ConservativeRasterizationMode),
+                 "WDDM 2.0 rasterizer prefix");
+   memcpy(&desc, source, sizeof(desc));
+   return CalcPrivateRasterizerStateSize11_1(device, &desc);
+}
+
+static void APIENTRY
+CreateRasterizerStateWDDM2_0(D3D10DDI_HDEVICE device,
+   const D3DWDDM2_0DDI_RASTERIZER_DESC *source,
+   D3D10DDI_HRASTERIZERSTATE state, D3D10DDI_HRTRASTERIZERSTATE rtState)
+{
+   if (source->ConservativeRasterizationMode !=
+       D3DWDDM2_0DDI_CONSERVATIVE_RASTERIZATION_OFF) {
+      SetError(device, E_INVALIDARG);
+      return;
+   }
+   D3D11_1_DDI_RASTERIZER_DESC desc;
+   memcpy(&desc, source, sizeof(desc));
+   CreateRasterizerState11_1(device, &desc, state, rtState);
+}
+
+static SIZE_T APIENTRY
+CalcPrivateQuerySizeWDDM2_0(D3D10DDI_HDEVICE device,
+   const D3DWDDM2_0DDIARG_CREATEQUERY *source)
+{
+   const D3D10DDIARG_CREATEQUERY desc = {source->Query, source->MiscFlags};
+   return CalcPrivateQuerySize(device, &desc);
+}
+
+static bool
+ValidContextWDDM2_0(D3D10DDI_HDEVICE device, UINT context)
+{
+   if (context & ~(D3DWDDM2_0DDI_CONTEXTTYPE_3D |
+                   D3DWDDM2_0DDI_CONTEXTTYPE_COMPUTE |
+                   D3DWDDM2_0DDI_CONTEXTTYPE_COPY)) {
+      SetError(device, E_INVALIDARG);
+      return false;
+   }
+   return true;
+}
+
+static void APIENTRY
+CreateQueryWDDM2_0(D3D10DDI_HDEVICE device,
+   const D3DWDDM2_0DDIARG_CREATEQUERY *source,
+   D3D10DDI_HQUERY query, D3D10DDI_HRTQUERY rtQuery)
+{
+   if (!ValidContextWDDM2_0(device, source->ContextType))
+      return;
+   const D3D10DDIARG_CREATEQUERY desc = {source->Query, source->MiscFlags};
+   CreateQuery(device, &desc, query, rtQuery);
+}
+
+static BOOL APIENTRY
+FlushWDDM2_0(D3D10DDI_HDEVICE device, UINT context, UINT flags)
+{
+   if (!ValidContextWDDM2_0(device, context))
+      return FALSE;
+   /* All supported engine types share the same ordered Gallium context. */
+   return Flush11_1(device, flags);
+}
+
+static void APIENTRY
+RelocateDeviceFuncsWDDM2_0(D3D10DDI_HDEVICE device,
+                          D3DWDDM2_0DDI_DEVICEFUNCS *funcs)
+{
+   /* The driver does not retain the runtime's function table address. */
+   LOG_ENTRYPOINT();
+}
+
+static void APIENTRY
+SetHardwareProtectionWDDM2_0(D3D10DDI_HDEVICE device,
+                            D3D10DDI_HRESOURCE resource, BOOL enabled)
+{
+   if (enabled)
+      SetError(device, E_INVALIDARG);
+}
+
+static void APIENTRY
+SetHardwareProtectionStateWDDM2_0(D3D10DDI_HDEVICE device, BOOL enabled)
+{
+   if (enabled)
+      SetError(device, E_INVALIDARG);
+}
+
+static void APIENTRY
+GetResourceLayoutWDDM2_0(D3D10DDI_HDEVICE device, D3D10DDI_HRESOURCE resource,
+   UINT count, D3DKMT_HANDLE *handle, D3DWDDM2_0DDI_TEXTURE_LAYOUT *layout,
+   UINT *transition, D3DWDDM2_0DDI_SUBRESOURCE_LAYOUT *subresources)
+{
+   /* Default textures remain opaque; CPU mapping uses ResourceMap. */
+   *handle = 0;
+   *layout = D3DWDDM2_0DDI_TL_UNDEFINED;
+   *transition = 0;
+   SetError(device, E_INVALIDARG);
+}
+
+static void
+FillDeviceFuncsWDDM2_0(D3DWDDM2_0DDI_DEVICEFUNCS *funcs)
+{
+   D3DWDDM1_3DDI_DEVICEFUNCS old = {};
+   FillDeviceFuncsWDDM1_3(&old);
+   static_assert(sizeof(old) ==
+                 offsetof(D3DWDDM2_0DDI_DEVICEFUNCS, pfnSetHardwareProtection),
+                 "WDDM 2.0 function table prefix");
+   memcpy(funcs, &old, sizeof(old));
+   funcs->pfnRelocateDeviceFuncs = RelocateDeviceFuncsWDDM2_0;
+   funcs->pfnFlush = FlushWDDM2_0;
+   funcs->pfnCalcPrivateShaderResourceViewSize = CalcPrivateShaderResourceViewSizeWDDM2_0;
+   funcs->pfnCreateShaderResourceView = CreateShaderResourceViewWDDM2_0;
+   funcs->pfnCalcPrivateRenderTargetViewSize = CalcPrivateRenderTargetViewSizeWDDM2_0;
+   funcs->pfnCreateRenderTargetView = CreateRenderTargetViewWDDM2_0;
+   funcs->pfnCalcPrivateUnorderedAccessViewSize = CalcPrivateUnorderedAccessViewSizeWDDM2_0;
+   funcs->pfnCreateUnorderedAccessView = CreateUnorderedAccessViewWDDM2_0;
+   funcs->pfnCalcPrivateRasterizerStateSize = CalcPrivateRasterizerStateSizeWDDM2_0;
+   funcs->pfnCreateRasterizerState = CreateRasterizerStateWDDM2_0;
+   funcs->pfnCalcPrivateQuerySize = CalcPrivateQuerySizeWDDM2_0;
+   funcs->pfnCreateQuery = CreateQueryWDDM2_0;
+   funcs->pfnSetHardwareProtection = SetHardwareProtectionWDDM2_0;
+   funcs->pfnSetHardwareProtectionState = SetHardwareProtectionStateWDDM2_0;
+   funcs->pfnGetResourceLayout = GetResourceLayoutWDDM2_0;
+}
+
+static HRESULT APIENTRY
+TrimResidencySetWDDM2_0(DXGI_DDI_ARG_TRIMRESIDENCYSET *args)
+{
+   D3D10DDI_HDEVICE device = {reinterpret_cast<void *>(args->hDevice)};
+   struct pipe_context *pipe = CastPipeContext(device);
+   /* Submit outstanding work so retired upload allocations can be released.
+    * Live blob backing remains resident for its resource lifetime.
+    */
+   yttrium_gdi_flush_labeled(pipe, NULL, 0, "DXGI trim residency");
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+CheckOverlayColorSpaceWDDM2_0(
+   DXGI_DDI_ARG_CHECKMULTIPLANEOVERLAYCOLORSPACESUPPORT *args)
+{
+   args->Supported = FALSE;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+PresentOverlayWDDM2_0(DXGI_DDI_ARG_PRESENTMULTIPLANEOVERLAY1 *args)
+{
+   return DXGI_ERROR_UNSUPPORTED;
+}
+
+static HRESULT APIENTRY
+RetrieveShaderCommentWDDM2_0(D3D10DDI_HDEVICE device, D3D10DDI_HSHADER shader,
+                            WCHAR *buffer, SIZE_T *count)
+{
+   /* Shader translation does not add a driver diagnostic comment. */
+   if (!count)
+      return E_INVALIDARG;
+   const SIZE_T capacity = *count;
+   *count = 1;
+   if (!buffer)
+      return S_OK;
+   if (!capacity)
+      return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+   buffer[0] = L'\0';
+   return S_OK;
+}
