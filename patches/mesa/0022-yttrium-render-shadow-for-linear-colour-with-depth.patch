+/*
+ * Shared colour images are LINEAR (yttrium_venus2_resource.c), and the
+ * draw path binds them as colour attachments.  A renderer need not support
+ * that: NVIDIA 610.57.04 reports no VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT
+ * in linearTilingFeatures for any format, yet still accepts the image.
+ * Rendering into it alone works there, but a render pass that also has a
+ * depth attachment makes the GPU reject the draw (Xid 69, class error on
+ * the Blackwell 3D class) and the context is lost.  Any D3D9/D3D10/D3D11
+ * application drawing with a depth buffer into its back buffer hits this.
+ *
+ * For that case the attachment is an OPTIMAL "render shadow" of the LINEAR
+ * image instead: the draw copies the LINEAR level into the shadow before
+ * the render pass and back after it, so the LINEAR image stays the only
+ * copy anything else reads.  Draws without depth, and renderers that do
+ * support linear colour attachments, are unchanged.
+ */
+static bool
+yttrium_venus_linear_color_attachment_supported(struct yttrium_venus *venus,
+                                                VkFormat format)
+{
+   uint8_t *cached = (uint32_t)format <
+         ARRAY_SIZE(venus->linear_color_attachment_formats) ?
+      &venus->linear_color_attachment_formats[format] : NULL;
+   if (cached && *cached)
+      return *cached == 2;
+
+   VkFormatProperties2 properties = {
+      .sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2,
+   };
+   vn_call_vkGetPhysicalDeviceFormatProperties2(
+      &venus->vn_ring, venus->physical_device, format, &properties);
+   const bool supported =
+      (properties.formatProperties.linearTilingFeatures &
+       VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT) != 0;
+   if (cached)
+      *cached = supported ? 2 : 1;
+   if (!supported)
+      YTTRIUM_LOG("yttrium: Venus renderer has no linear colour attachment "
+                  "support for vk_format=%u; depth draws into linear "
+                  "targets use a render shadow\n", format);
+   return supported;
+}
+
+static bool
+yttrium_venus_color_render_shadow(struct yttrium_venus *venus,
+                                  const struct yttrium_venus_resource *color,
+                                  VkFormat attachment_format,
+                                  bool has_depth,
+                                  bool feedback_loop)
+{
+   if (!venus || !color || !has_depth || feedback_loop ||
+       color->buffer_backed || color->tiling != VK_IMAGE_TILING_LINEAR ||
+       (color->samples && color->samples != VK_SAMPLE_COUNT_1_BIT) ||
+       color->depth > 1)
+      return false;
+   return !yttrium_venus_linear_color_attachment_supported(
+             venus, color->vk_format) ||
+          (attachment_format != color->vk_format &&
+           !yttrium_venus_linear_color_attachment_supported(
+              venus, attachment_format));
+}
+
+static bool
+yttrium_venus_ensure_render_shadow(struct yttrium_venus *venus,
+                                   struct yttrium_venus_resource *color)
+{
+   if (color->render_shadow_image)
+      return true;
+
+   const VkImageCreateInfo image_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .flags = VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = color->vk_format,
+      .extent = { color->width, color->height, 1 },
+      .mipLevels = MAX2(color->levels, 1),
+      .arrayLayers = MAX2(color->layers, 1),
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+               VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+               VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+   };
+   yttrium_venus_init_object(venus, &color->render_shadow_image_obj);
+   VkImage image =
+      YTTRIUM_VENUS_HANDLE(VkImage, &color->render_shadow_image_obj);
+   VkResult result = vn_call_vkCreateImage(&venus->vn_ring,
+                                           venus->device_handle,
+                                           &image_info, NULL, &image);
+   if (result != VK_SUCCESS) {
+      YTTRIUM_WARN("yttrium: Venus render shadow vkCreateImage failed "
+                   "result=%d %ux%u levels=%u layers=%u vk_format=%u\n",
+                   result, color->width, color->height, color->levels,
+                   color->layers, color->vk_format);
+      memset(&color->render_shadow_image_obj, 0,
+             sizeof(color->render_shadow_image_obj));
+      return false;
+   }
+
+   VkMemoryRequirements reqs;
+   memset(&reqs, 0, sizeof(reqs));
+   vn_call_vkGetImageMemoryRequirements(&venus->vn_ring,
+                                        venus->device_handle, image, &reqs);
+   const uint32_t memory_type_index =
+      yttrium_venus_choose_memory_type(venus, reqs.memoryTypeBits, 0,
+                                       VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+   yttrium_venus_init_object(venus, &color->render_shadow_memory_obj);
+   VkDeviceMemory memory =
+      YTTRIUM_VENUS_HANDLE(VkDeviceMemory, &color->render_shadow_memory_obj);
+   result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   if (reqs.size && memory_type_index != UINT32_MAX) {
+      const VkMemoryAllocateInfo memory_info = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+         .allocationSize = reqs.size,
+         .memoryTypeIndex = memory_type_index,
+      };
+      result = vn_call_vkAllocateMemory(&venus->vn_ring,
+                                        venus->device_handle,
+                                        &memory_info, NULL, &memory);
+      if (result == VK_SUCCESS) {
+         result = vn_call_vkBindImageMemory(&venus->vn_ring,
+                                            venus->device_handle,
+                                            image, memory, 0);
+         if (result != VK_SUCCESS)
+            vn_async_vkFreeMemory(&venus->vn_ring, venus->device_handle,
+                                  memory, NULL);
+      }
+   }
+   if (result != VK_SUCCESS) {
+      YTTRIUM_WARN("yttrium: Venus render shadow memory failed result=%d "
+                   "size=0x%llx bits=0x%x\n", result,
+                   (unsigned long long)reqs.size, reqs.memoryTypeBits);
+      vn_async_vkDestroyImage(&venus->vn_ring, venus->device_handle,
+                              image, NULL);
+      memset(&color->render_shadow_image_obj, 0,
+             sizeof(color->render_shadow_image_obj));
+      memset(&color->render_shadow_memory_obj, 0,
+             sizeof(color->render_shadow_memory_obj));
+      return false;
+   }
+
+   color->render_shadow_image = image;
+   color->render_shadow_memory = memory;
+   color->render_shadow_layout = VK_IMAGE_LAYOUT_UNDEFINED;
+   YTTRIUM_LOG("yttrium: Venus render shadow created image_id=%llu for "
+               "linear image_id=%llu %ux%u vk_format=%u\n",
+               (unsigned long long)color->render_shadow_image_obj.id,
+               (unsigned long long)color->image_obj.id,
+               color->width, color->height, color->vk_format);
+   return true;
+}
+
+/*
+ * Copy one level and layer range between a LINEAR colour image and its
+ * render shadow, outside a render pass.  Both images are in
+ * COLOR_ATTACHMENT_OPTIMAL before and after, as the draw path expects.
+ */
+static void
+yttrium_venus_cmd_render_shadow_copy(struct yttrium_venus *venus,
+                                     struct yttrium_venus_resource *color,
+                                     uint32_t level, uint32_t layer,
+                                     uint32_t layers, bool to_shadow)
+{
+   const VkImageSubresourceRange range = {
+      .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+      .baseMipLevel = level,
+      .levelCount = 1,
+      .baseArrayLayer = layer,
+      .layerCount = layers,
+   };
+   const VkImage src = to_shadow ? color->image : color->render_shadow_image;
+   const VkImage dst = to_shadow ? color->render_shadow_image : color->image;
+   const VkImageLayout shadow_layout =
+      color->render_shadow_layout == VK_IMAGE_LAYOUT_UNDEFINED ?
+         VK_IMAGE_LAYOUT_UNDEFINED : VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+   const VkAccessFlags attachment_access =
+      VK_ACCESS_COLOR_ATTACHMENT_READ_BIT |
+      VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+   const VkPipelineStageFlags stages =
+      VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+   VkImageMemoryBarrier barriers[2] = {
+      {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+         .srcAccessMask = attachment_access | VK_ACCESS_TRANSFER_WRITE_BIT,
+         .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+         .oldLayout = to_shadow ? VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL :
+                                  shadow_layout,
+         .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+         .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .image = src,
+         .subresourceRange = range,
+      },
+      {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+         .srcAccessMask = attachment_access | VK_ACCESS_TRANSFER_READ_BIT |
+                          VK_ACCESS_TRANSFER_WRITE_BIT,
+         .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+         .oldLayout = to_shadow ? shadow_layout :
+                                  VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+         .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+         .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .image = dst,
+         .subresourceRange = range,
+      },
+   };
+   vn_async_vkCmdPipelineBarrier(&venus->vn_ring, venus->command_buffer,
+                                 stages, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+                                 0, NULL, 0, NULL, 2, barriers);
+
+   const VkImageCopy region = {
+      .srcSubresource = {
+         .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+         .mipLevel = level,
+         .baseArrayLayer = layer,
+         .layerCount = layers,
+      },
+      .dstSubresource = {
+         .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+         .mipLevel = level,
+         .baseArrayLayer = layer,
+         .layerCount = layers,
+      },
+      .extent = {
+         yttrium_venus_subresource_width(color, level),
+         yttrium_venus_subresource_height(color, level),
+         1,
+      },
+   };
+   vn_async_vkCmdCopyImage(&venus->vn_ring, venus->command_buffer,
+                           src, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                           dst, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                           1, &region);
+
+   for (uint32_t i = 0; i < 2; i++) {
+      barriers[i].srcAccessMask = i ? VK_ACCESS_TRANSFER_WRITE_BIT :
+                                      VK_ACCESS_TRANSFER_READ_BIT;
+      barriers[i].dstAccessMask = attachment_access |
+         VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT |
+         VK_ACCESS_SHADER_READ_BIT;
+      barriers[i].oldLayout = barriers[i].newLayout;
+      barriers[i].newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+   }
+   vn_async_vkCmdPipelineBarrier(&venus->vn_ring, venus->command_buffer,
+                                 VK_PIPELINE_STAGE_TRANSFER_BIT, stages, 0,
+                                 0, NULL, 0, NULL, 2, barriers);
+   color->render_shadow_layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+}
+
+/* Whether a draw with this pipeline renders through any render shadow. */
+static bool
+yttrium_venus_draw_uses_render_shadow(
+   struct yttrium_venus *venus,
+   const struct yttrium_pipeline *pipeline,
+   struct yttrium_venus_resource *const *color_resources,
+   uint32_t color_resource_count,
+   bool has_depth)
+{
+   for (uint32_t i = 0; i < color_resource_count; i++) {
+      const struct yttrium_venus_resource *color = color_resources[i];
+      if (!color || !color->render_shadow_image)
+         continue;
+      const VkFormat attachment_format =
+         pipeline->key.rt_format[i] != VK_FORMAT_UNDEFINED ?
+         pipeline->key.rt_format[i] : color->vk_format;
+      if (yttrium_venus_color_render_shadow(
+             venus, color, attachment_format, has_depth,
+             (pipeline->key.color_feedback_loop_mask & (1u << i)) != 0))
+         return true;
+   }
+   return false;
+}
+
+static void
+yttrium_venus_cmd_render_shadow_copies(
+   struct yttrium_venus *venus,
+   const struct yttrium_pipeline *pipeline,
+   const struct yttrium_venus_draw_state *draw_state,
+   struct yttrium_venus_resource *const *color_resources,
+   uint32_t color_resource_count,
+   bool has_depth,
+   uint32_t render_level,
+   uint32_t render_layer,
+   uint32_t render_layers,
+   bool to_shadow)
+{
+   for (uint32_t i = 0; i < color_resource_count; i++) {
+      struct yttrium_venus_resource *color = color_resources[i];
+      if (!color || !color->render_shadow_image)
+         continue;
+      const VkFormat attachment_format =
+         pipeline->key.rt_format[i] != VK_FORMAT_UNDEFINED ?
+         pipeline->key.rt_format[i] : color->vk_format;
+      if (!yttrium_venus_color_render_shadow(
+             venus, color, attachment_format, has_depth,
+             (pipeline->key.color_feedback_loop_mask & (1u << i)) != 0))
+         continue;
+      const uint32_t level =
+         draw_state && i < ARRAY_SIZE(draw_state->rt_level) ?
+            draw_state->rt_level[i] : render_level;
+      const uint32_t layer =
+         draw_state && i < ARRAY_SIZE(draw_state->rt_layer) ?
+            draw_state->rt_layer[i] : render_layer;
+      yttrium_venus_cmd_render_shadow_copy(venus, color, level, layer,
+                                           render_layers, to_shadow);
+   }
+}
+
 static bool
 yttrium_venus_cmd_batch_transition_image(struct yttrium_venus *venus,
                                          struct yttrium_venus_resource *resource,
@@ -3352,9 +3663,15 @@ yttrium_venus2_pipeline_init(struct yttrium_venus *venus,
       const uint32_t color_layer =
          draw_state && i < ARRAY_SIZE(draw_state->rt_layer) ?
             draw_state->rt_layer[i] : render_layer;
+      /* A LINEAR target next to depth renders through its OPTIMAL shadow. */
+      const bool render_shadow = yttrium_venus_color_render_shadow(
+         venus, color, attachment_format, has_depth,
+         (color_feedback_loop_mask & (1u << i)) != 0);
+      if (render_shadow && !yttrium_venus_ensure_render_shadow(venus, color))
+         goto pipeline_submit_failed;
       const VkImageViewCreateInfo view_info = {
          .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
-         .image = color->image,
+         .image = render_shadow ? color->render_shadow_image : color->image,
          .viewType = yttrium_venus_render_view_type(color, render_layers),
          .format = attachment_format,
          .subresourceRange = {
@@ -9669,6 +9986,9 @@ retry_batch_layout:
    struct yttrium_venus_render_pass_group_key render_pass_key;
    bool render_pass_key_valid = false;
    memset(&render_pass_key, 0, sizeof(render_pass_key));
+   const bool draw_uses_render_shadow =
+      yttrium_venus_draw_uses_render_shadow(venus, pipeline, color_resources,
+                                            color_resource_count, has_depth);
    const bool render_pass_batch_allowed =
       native_draw_batch_candidate && !draw_indirect &&
       (!has_cpu_vertex_upload || !has_sampled_descriptor ||
@@ -9676,7 +9996,9 @@ retry_batch_layout:
       yttrium_venus_deferred_draw_allowed(
          pipeline, sampled_images, sampled_image_count, color_resources,
          color_resource_count, depth_resource, storage_image_count,
-         so_target_count, draw_auto);
+         so_target_count, draw_auto) &&
+      /* The render shadow copies wrap one render pass; draw it directly. */
+      !draw_uses_render_shadow;
    if (render_pass_batch_allowed) {
       render_pass_key_valid =
          yttrium_venus_deferred_draw_make_render_key(
@@ -11128,6 +11450,11 @@ retry_batch_layout:
              instance_count, vertex_offset))
