diff --git a/src/gallium/winsys/yttrium/gdi/yttrium_venus2_impl.c b/src/gallium/winsys/yttrium/gdi/yttrium_venus2_impl.c
index 97692f9..b2bf7a0 100644
--- a/src/gallium/winsys/yttrium/gdi/yttrium_venus2_impl.c
+++ b/src/gallium/winsys/yttrium/gdi/yttrium_venus2_impl.c
