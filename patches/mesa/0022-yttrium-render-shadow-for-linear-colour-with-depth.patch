+            venus, pipeline, draw_state, color_resources,
+            color_resource_count, has_depth, render_level, render_layer,
+            render_layers, true);
       const VkRenderPassBeginInfo render_pass_begin = {
          .sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO,
          .renderPass = pipeline->render_pass,
@@ -11259,6 +11586,11 @@ retry_batch_layout:
             so_counter_buffers, so_counter_offsets);
       }
       vn_async_vkCmdEndRenderPass(&venus->vn_ring, venus->command_buffer);
+      if (draw_uses_render_shadow)
+         yttrium_venus_cmd_render_shadow_copies(
+            venus, pipeline, draw_state, color_resources,
+            color_resource_count, has_depth, render_level, render_layer,
+            render_layers, false);
