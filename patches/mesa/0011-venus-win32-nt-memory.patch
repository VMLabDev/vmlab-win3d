+#if defined(HAVE_YTTRIUM)
+VKAPI_ATTR VkResult VKAPI_CALL
+vn_GetMemoryWin32HandleKHR(VkDevice device,
+                          const VkMemoryGetWin32HandleInfoKHR *info,
+                          HANDLE *handle)
+{
+   struct vn_device *dev = vn_device_from_handle(device);
+   struct vn_device_memory *mem = vn_device_memory_from_handle(info->memory);
+   if (info->handleType != VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT ||
+       !mem->export_nt_handle)
+      return vn_error(dev->instance, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   if (!DuplicateHandle(GetCurrentProcess(), mem->export_nt_handle,
+                        GetCurrentProcess(), handle, 0, mem->export_nt_inherit,
+                        DUPLICATE_SAME_ACCESS))
+      return vn_error(dev->instance, VK_ERROR_OUT_OF_HOST_MEMORY);
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vn_GetMemoryWin32HandlePropertiesKHR(VkDevice device,
+                                   VkExternalMemoryHandleTypeFlagBits handleType,
+                                   HANDLE handle,
+                                   VkMemoryWin32HandlePropertiesKHR *properties)
+{
+   /* Opaque handles are the only supported Win32 type. Vulkan excludes them
+    * from this query; their memory type is specified by the exporting device.
+    */
+   struct vn_device *dev = vn_device_from_handle(device);
+   return vn_error(dev->instance, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+}
+#endif
