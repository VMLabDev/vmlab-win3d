+/* For GetCaps, which runs before any device and has no screen: ask the host
+ * over a short-lived Venus connection, as D3D9QueryMsaaTypes does, once per
+ * process.  If that is not possible, stay optimistic as before; the
+ * per-format CheckFormatSupport answer is exact either way. */
+bool
+QueryTypedUavLoadAdditionalFormats(void)
+{
+   const LONG known = g_TypedUavLoadAdditionalFormats;
+   if (known >= 0)
+      return known != 0;
+
+   HDC hdc = GetDC(NULL);
+   if (!hdc)
+      return true;
+   struct gdikmt_device *device = gdikmt_create_from_hdc(hdc);
+   ReleaseDC(NULL, hdc);
+   if (!device)
+      return true;
+   struct yttrium_venus *venus = yttrium_venus_create(device);
+   if (!venus) {
+      device->destroy(device);
+      return true;
+   }
+   bool supported = true;
+   for (unsigned i = 0; i < ARRAY_SIZE(TypedUavLoadAdditionalFormats); ++i) {
+      if (!yttrium_venus_storage_image_formatless_format_supported(
+             venus, TypedUavLoadAdditionalFormats[i], true, true)) {
+         supported = false;
+         break;
+      }
+   }
+   yttrium_venus_destroy(venus);
+   device->destroy(device);
+   InterlockedCompareExchange(&g_TypedUavLoadAdditionalFormats,
+                              supported ? 1 : 0, -1);
+   return supported;
+}
