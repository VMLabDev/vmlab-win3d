+/* The r32_image_mask bit of an image variable, or 0. */
+static uint64_t
+yttrium_shader_r32_image_slot(const struct yttrium_shader_state *shader,
+                              const nir_variable *var)
+{
+   const unsigned binding = var->data.binding;
+   if (binding < YTTRIUM_SHADER_STORAGE_IMAGE_BINDING_BASE ||
+       binding >= YTTRIUM_SHADER_STORAGE_IMAGE_BINDING_BASE +
+                  PIPE_MAX_SHADER_IMAGES)
+      return 0;
+   return shader->r32_image_mask &
+          (1ull << (binding - YTTRIUM_SHADER_STORAGE_IMAGE_BINDING_BASE));
+}
+
+static void
+yttrium_shader_mark_r32_image(struct yttrium_shader_state *shader,
+                              unsigned binding, enum pipe_format format)
+{
+   const uint64_t bit =
+      1ull << (binding - YTTRIUM_SHADER_STORAGE_IMAGE_BINDING_BASE);
+   shader->r32_image_mask |= bit;
+   if (format == PIPE_FORMAT_R32_UINT)
+      shader->formatless_image_uint_mask |= bit;
+   if (format == PIPE_FORMAT_R32_SINT)
+      shader->formatless_image_sint_mask |= bit;
+}
+
+/* A generated variant keeps the R32 declaration of its parent; restore the
+ * mask the pipeline checks views against.  Only called on devices without
+ * formatless reads.  Typed atomic images are R32 as well, so marking them
+ * asks nothing D3D does not already require. */
+static void
+yttrium_shader_note_r32_image(struct yttrium_shader_state *shader,
+                              const nir_variable *var)
+{
+   const unsigned binding = var->data.binding;
+   const enum pipe_format format = var->data.image.format;
+   if (glsl_type_is_array(var->type) ||
+       binding < YTTRIUM_SHADER_STORAGE_IMAGE_BINDING_BASE ||
+       binding >= YTTRIUM_SHADER_STORAGE_IMAGE_BINDING_BASE +
+                  PIPE_MAX_SHADER_IMAGES ||
+       (format != PIPE_FORMAT_R32_FLOAT && format != PIPE_FORMAT_R32_UINT &&
+        format != PIPE_FORMAT_R32_SINT))
+      return;
+   yttrium_shader_mark_r32_image(shader, binding, format);
+}
+
+/* The device cannot read formatless storage images.  D3D11 then allows
+ * typed UAV loads only from R32_FLOAT, R32_UINT and R32_SINT views (the
+ * additional formats are reported unsupported), so declare the image with
+ * the R32 format of its numeric type: that needs no Vulkan feature, and
+ * stores through it stay correct because the view must be R32 to be loaded
+ * from at all.  The pipeline rejects any other view. */
+static bool
+yttrium_shader_declare_r32_image(struct yttrium_shader_state *shader,
+                                 nir_variable *var, bool read, bool write)
+{
+   const struct glsl_type *type = glsl_without_array(var->type);
+   enum pipe_format format;
+   switch (glsl_get_sampler_result_type(type)) {
+   case GLSL_TYPE_FLOAT: format = PIPE_FORMAT_R32_FLOAT; break;
+   case GLSL_TYPE_UINT: format = PIPE_FORMAT_R32_UINT; break;
+   case GLSL_TYPE_INT: format = PIPE_FORMAT_R32_SINT; break;
+   default: return false;
+   }
+   var->data.image.format = format;
+   var->data.access &= ~(ACCESS_NON_READABLE | ACCESS_NON_WRITEABLE);
+   if (!read)
+      var->data.access |= ACCESS_NON_READABLE;
+   if (!write)
+      var->data.access |= ACCESS_NON_WRITEABLE;
+   yttrium_shader_mark_r32_image(shader, var->data.binding, format);
+   YTTRIUM_WARN("yttrium: shader image declared %s owner=yttrium-shader stage=%s id=%u binding=%u read=%u write=%u reason=no-formatless-image-read\n",
+                util_format_name(format), yttrium_shader_stage_name(shader->stage),
+                shader->id, var->data.binding, read, write);
+   return true;
+}
