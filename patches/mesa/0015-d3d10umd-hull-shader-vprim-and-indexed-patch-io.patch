+/* The TGSI PATCH output for patch constant oN.  An index range may cover
+ * registers that the phase does not declare itself (fxc declares only the
+ * ones it addresses directly), so declare them here.
+ */
+static struct ureg_dst
+tcs_patch_output_reg(struct Shader_xlate *sx, unsigned output,
+                     unsigned writemask)
+{
+   for (unsigned c = 0; c < 4; ++c) {
+      if ((writemask & (1u << c)) && sx->outputs[output].reg[c].File)
+         return sx->outputs[output].reg[c];
+   }
+   for (unsigned c = 0; c < 4; ++c) {
+      if (sx->outputs[output].reg[c].File)
+         return sx->outputs[output].reg[c];
+   }
+
+   struct ureg_dst reg =
+      ureg_DECL_output(sx->ureg, TGSI_SEMANTIC_PATCH, output);
+   for (unsigned c = 0; c < 4; ++c)
+      sx->outputs[output].reg[c] = reg;
+   sx->outputs[output].declared_mask |= TGSI_WRITEMASK_XYZW;
+   return reg;
+}
