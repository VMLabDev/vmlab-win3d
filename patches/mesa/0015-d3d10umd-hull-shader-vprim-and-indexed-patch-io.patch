+static struct ureg_src
+apply_input_vertex_index(struct Shader_xlate *sx,
+                         struct ureg_src reg,
+                         const struct Shader_index *vertex,
+                         struct ureg_src vertex_addr)
+{
+   switch (vertex->index_rep) {
+   case D3D10_SB_OPERAND_INDEX_IMMEDIATE32:
+      return ureg_src_dimension(reg, vertex->imm);
+   case D3D10_SB_OPERAND_INDEX_RELATIVE:
+      return ureg_src_dimension_indirect(reg, vertex_addr, 0);
+   case D3D10_SB_OPERAND_INDEX_IMMEDIATE32_PLUS_RELATIVE:
+      return ureg_src_dimension_indirect(reg, vertex_addr, vertex->imm);
+   default:
+      SHADER_TRANSLATION_UNSUPPORTED(sx, true);
+      return reg;
+   }
+}
+
+/* vicp[vertex][base + rel] (and v[vertex][base + rel] in a geometry
+ * shader): the inputs of an index range are separate TGSI inputs, so select
+ * among them, each one read at the same vertex.
+ */
+static struct ureg_src
+translate_indexed_vertex_input(struct Shader_xlate *sx,
+                               uint base,
+                               struct ureg_src rel,
+                               const struct Shader_index *vertex,
+                               struct ureg_src vertex_addr)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct ureg_dst selected, predicate;
+   uint count;
+
+   if (base >= SHADER_MAX_INPUTS || !find_input_index_range(sx, base, &count)) {
+      SHADER_TRANSLATION_UNSUPPORTED(sx, true);
+      return sx->inputs[base < SHADER_MAX_INPUTS ? base : 0].reg;
+   }
+
+   if (count <= 1)
+      return apply_input_vertex_index(sx, sx->inputs[base].reg, vertex,
+                                      vertex_addr);
+
+   selected = ureg_DECL_temporary(ureg);
+   predicate = ureg_DECL_temporary(ureg);
+
+   ureg_MOV(ureg, selected,
+            apply_input_vertex_index(sx, sx->inputs[base].reg, vertex,
+                                     vertex_addr));
+   for (uint i = 1; i < count; i++) {
+      if (!sx->inputs[base + i].declared) {
+         SHADER_TRANSLATION_UNSUPPORTED(sx, true);
+         continue;
+      }
+
+      ureg_USEQ(ureg, predicate, rel, ureg_imm1u(ureg, i));
+      ureg_UCMP(ureg, selected, ureg_src(predicate),
+                apply_input_vertex_index(sx, sx->inputs[base + i].reg,
+                                         vertex, vertex_addr),
+                ureg_src(selected));
+   }
+
+   ureg_release_temporary(ureg, predicate);
+
+   return ureg_src(selected);
+}
