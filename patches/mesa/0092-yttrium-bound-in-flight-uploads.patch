+/* Resource statistics, logged every 5 s with D3D10UMD_YTTRIUM_UPLOAD_STATS=1
+ * (docs/f6va.md): upload buffers (u_upload_mgr buffers under the ordered
+ * context worker), other buffers, textures, buffer-replacement storages
+ * and the winsys's own Venus memory mappings. created counts and MiB are totals; live ones are current. */
+enum yttrium_stats_class {
+   YTTRIUM_STATS_UPLOAD,
+   YTTRIUM_STATS_BUFFER,
+   YTTRIUM_STATS_TEXTURE,
+   YTTRIUM_STATS_STORAGE,
+   YTTRIUM_STATS_VENUS_MAPPING,
+   YTTRIUM_STATS_MAPPED_BLOB,
+   YTTRIUM_STATS_MAPPED_LOCK,
+   YTTRIUM_STATS_HEAP_DATA,
+   YTTRIUM_STATS_BLOB_MAP,
+   YTTRIUM_STATS_SKIPPED_UNMAP,
+   YTTRIUM_STATS_COUNT,
+};
+
+static struct {
+   int64_t created, created_bytes, live, live_bytes, peak_live_bytes;
+} yttrium_stats[YTTRIUM_STATS_COUNT];
+static int64_t yttrium_stats_last_log_ns;
+
+static bool
+yttrium_stats_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = yttrium_gdi_debug_get_bool_option(
+         "D3D10UMD_YTTRIUM_UPLOAD_STATS", false) ? 1 : 0;
+   return enabled != 0;
+}
+
+static void
+yttrium_stats_update(enum yttrium_stats_class c, int64_t bytes, bool create)
+{
+   if (!yttrium_stats_enabled())
+      return;
+
+   if (create) {
+      p_atomic_inc(&yttrium_stats[c].created);
+      p_atomic_add(&yttrium_stats[c].created_bytes, bytes);
+      p_atomic_inc(&yttrium_stats[c].live);
+      const int64_t live =
+         p_atomic_add_return(&yttrium_stats[c].live_bytes, bytes);
+      if (live > p_atomic_read(&yttrium_stats[c].peak_live_bytes))
+         p_atomic_set(&yttrium_stats[c].peak_live_bytes, live);
+   } else {
+      p_atomic_dec(&yttrium_stats[c].live);
+      p_atomic_add(&yttrium_stats[c].live_bytes, -bytes);
+   }
+
+   const int64_t now = os_time_get_nano();
+   const int64_t last = p_atomic_read(&yttrium_stats_last_log_ns);
+   if (now - last < 5000000000ll ||
+       p_atomic_cmpxchg(&yttrium_stats_last_log_ns, last, now) != last)
+      return;
+   static const char *const names[YTTRIUM_STATS_COUNT] = {
+      "upload", "buffer", "texture", "storage", "venus-mapping",
+      "resource-blob-map", "resource-lock-map", "resource-heap-data",
+      "blob-map-escape", "skipped-blob-unmap",
+   };
+   for (unsigned i = 0; i < YTTRIUM_STATS_COUNT; i++) {
+      YTTRIUM_WARN("yttrium: %s stats created=%lld created_mib=%lld live=%lld live_mib=%lld peak_live_mib=%lld\n",
+                   names[i],
+                   (long long)p_atomic_read(&yttrium_stats[i].created),
+                   (long long)(p_atomic_read(&yttrium_stats[i].created_bytes) >> 20),
+                   (long long)p_atomic_read(&yttrium_stats[i].live),
+                   (long long)(p_atomic_read(&yttrium_stats[i].live_bytes) >> 20),
+                   (long long)(p_atomic_read(&yttrium_stats[i].peak_live_bytes) >> 20));
+   }
+}
+
+/* For yttrium_venus_map_memory and yttrium_venus_unmap_memory. */
+void
+yttrium_stats_venus_mapping(uint64_t bytes, bool create)
+{
+   yttrium_stats_update(YTTRIUM_STATS_VENUS_MAPPING, (int64_t)bytes, create);
+}
+
+/* Every VIOGPU_RES_MAP_BLOB and VIOGPU_RES_UNMAP_BLOB escape that succeeded,
+ * and unmaps skipped because the runtime destroyed the allocation. */
+void
+yttrium_stats_blob_map(uint64_t bytes, bool create)
+{
+   yttrium_stats_update(YTTRIUM_STATS_BLOB_MAP, (int64_t)bytes, create);
+}
+
+void
+yttrium_stats_skipped_unmap(uint64_t bytes)
+{
+   yttrium_stats_update(YTTRIUM_STATS_SKIPPED_UNMAP, (int64_t)bytes, true);
+}
+
+/* Bytes of live upload buffers, for the upload budget
+ * (yttrium_venus_bound_in_flight_uploads). Counted with or without stats. */
+static int64_t yttrium_live_upload_bytes;
+
+uint64_t
+yttrium_resource_live_upload_bytes(void)
+{
+   const int64_t bytes = p_atomic_read(&yttrium_live_upload_bytes);
+   return bytes > 0 ? (uint64_t)bytes : 0;
+}
+
+/* 256 MiB in a 32-bit process, unbounded in a 64-bit one; UPLOAD_BUDGET_MB
+ * in yttrium.ini overrides it (0 turns it off). */
+static uint64_t
+yttrium_resource_upload_budget(void)
+{
+   static int64_t budget_mb = -1;
+
+   if (budget_mb < 0) {
+      const int64_t value = yttrium_gdi_debug_get_num_option(
+         "D3D10UMD_YTTRIUM_UPLOAD_BUDGET_MB",
+         sizeof(void *) == 4 ? 256 : 0);
+      budget_mb = value > 0 ? value : 0;
+   }
+   return (uint64_t)budget_mb << 20;
+}
+
+bool
+yttrium_resource_uploads_over_budget(void)
+{
+   const uint64_t budget = yttrium_resource_upload_budget();
+   return budget && yttrium_resource_live_upload_bytes() > budget;
+}
+
+bool
+yttrium_gdi_uploads_over_budget(void)
+{
+   return yttrium_resource_uploads_over_budget();
+}
+
+static void
+yttrium_upload_stats_update(const struct yttrium_resource *res, bool create)
+{
+   if (res->ordered_worker_upload_buffer)
+      p_atomic_add(&yttrium_live_upload_bytes,
+                   create ? (int64_t)res->size : -(int64_t)res->size);
+
+   const enum yttrium_stats_class c =
+      res->ordered_worker_upload_buffer ? YTTRIUM_STATS_UPLOAD :
+      res->base.target == PIPE_BUFFER ? YTTRIUM_STATS_BUFFER :
+      YTTRIUM_STATS_TEXTURE;
+   yttrium_stats_update(c, (int64_t)res->size, create);
+   if (res->map)
+      yttrium_stats_update(res->map_is_blob ? YTTRIUM_STATS_MAPPED_BLOB :
+                                              YTTRIUM_STATS_MAPPED_LOCK,
+                           (int64_t)res->size, create);
+   if (res->owns_data && res->data)
+      yttrium_stats_update(YTTRIUM_STATS_HEAP_DATA,
+                           (int64_t)res->data_capacity, create);
+}
