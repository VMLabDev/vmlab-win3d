+/*
+ * Upload buffers (u_upload_mgr buffers under the ordered context worker) are
+ * mapped blobs, and each stays alive until the last batch that used it
+ * retires. Batches are retired by polling when a new one is acquired, up to
+ * 64 wait to be submitted as one group, and the pool grows to 256 batches,
+ * so a program that streams uploads faster than the host completes them
+ * keeps hundreds of them alive (docs/f6va.md). After a flush, while the
+ * live upload buffers are over the budget (over_budget), submit what is
+ * pending, retire what has completed, then wait for the oldest batch.
+ */
+void
+yttrium_venus2_bound_in_flight_uploads(struct yttrium_venus *venus,
+                                       bool (*over_budget)(void))
+{
+   static const char label[] = "upload budget";
+
+   if (!venus || !over_budget || !over_budget())
+      return;
+
+   if (!yttrium_venus_flush_pending_submits(venus, label) ||
+       !yttrium_venus_retire_completed_batches(venus, label))
+      return;
+
+   while (over_budget()) {
+      struct yttrium_venus_batch *oldest = NULL;
+      for (uint32_t i = 0; i < venus->batch_count; i++) {
+         struct yttrium_venus_batch *batch = venus->batches[i];
+         if (!batch || !batch->busy || batch->pending_submit ||
+             !batch->submit_order)
+            continue;
+         if (!oldest || batch->submit_order < oldest->submit_order)
+            oldest = batch;
+      }
+      if (!oldest || !yttrium_venus_wait_batch(venus, oldest, label))
+         return;
+   }
+}
