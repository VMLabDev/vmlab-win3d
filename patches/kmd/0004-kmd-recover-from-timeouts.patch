+NTSTATUS VioGpuAdapter::CollectDbgInfo(CONST DXGKARG_COLLECTDBGINFO *info)
+{
+    // Fixed storage only: this timeout diagnostic runs at DISPATCH_LEVEL.
+    struct SNAPSHOT
+    {
+        VIOGPU_TDR_DIAGNOSTICS Recovery;
+        UINT32 Version, Size, Nodes, Engines;
+        LONG Submitted[kMaxTrackedNodes][kMaxTrackedEngines];
+        LONG Completed[kMaxTrackedNodes][kMaxTrackedEngines];
+        LONG Preemption[kMaxTrackedNodes][kMaxTrackedEngines];
+        LONG Outstanding[kMaxTrackedNodes][kMaxTrackedEngines];
+        LONG IntxCombined, BadTimelineResponse, Generation, PowerResets;
+    } snapshot = {};
+    if (!info || !info->pBuffer || info->BufferSize < sizeof(snapshot.Recovery))
+        return STATUS_BUFFER_TOO_SMALL;
+    snapshot.Recovery = m_tdr;
+    snapshot.Version = 1;
+    snapshot.Size = sizeof(snapshot);
+    snapshot.Nodes = kMaxTrackedNodes;
+    snapshot.Engines = kMaxTrackedEngines;
+    for (UINT node = 0; node < kMaxTrackedNodes; ++node)
+    {
+        for (UINT engine = 0; engine < kMaxTrackedEngines; ++engine)
+        {
+            snapshot.Submitted[node][engine] = InterlockedCompareExchange(&m_lastSubmittedFence[node][engine], 0, 0);
+            snapshot.Completed[node][engine] = InterlockedCompareExchange(&m_lastNotifiedFence[node][engine], 0, 0);
+            snapshot.Preemption[node][engine] = InterlockedCompareExchange(&m_pendingPreemptionFence[node][engine], 0, 0);
+            snapshot.Outstanding[node][engine] = InterlockedCompareExchange(&m_preemptSubmittedOutstanding[node][engine], 0, 0);
+        }
+    }
+    snapshot.IntxCombined = m_intxCombinedCount;
+    snapshot.BadTimelineResponse = m_badTimelineResponseCount;
+    snapshot.Generation = m_transportGeneration;
+    snapshot.PowerResets = m_powerResetCount;
+    RtlCopyMemory(info->pBuffer, &snapshot, min(info->BufferSize, sizeof(snapshot)));
+    return STATUS_SUCCESS;
+}
