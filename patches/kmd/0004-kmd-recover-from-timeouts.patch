+void VioGpuAdapter::RegisterPreparedCommand(VioGpuCommand *command)
+{
+    ExInterlockedInsertTailList(&m_preparedCommands, &command->m_preparedEntry, &m_preparedCommandLock);
+}
+
+void VioGpuAdapter::UnregisterPreparedCommand(VioGpuCommand *command)
+{
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_preparedCommandLock, &oldIrql);
+    RemoveEntryList(&command->m_preparedEntry);
+    InitializeListHead(&command->m_preparedEntry);
+    KeReleaseSpinLock(&m_preparedCommandLock, oldIrql);
+}
