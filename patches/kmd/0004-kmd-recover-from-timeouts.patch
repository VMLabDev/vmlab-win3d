+void VioGpuAdapter::Trace(UINT event, UINT node, UINT engine, UINT context,
+                          UINT flags, UINT64 fence, UINT response, UINT pending)
+{
+    LONG64 sequence = InterlockedIncrement64(&m_traceSequence);
+    VIOGPU_TRACE_RECORD *record = &m_trace[(sequence - 1) % RTL_NUMBER_OF(m_trace)];
+    InterlockedExchange64(reinterpret_cast<volatile LONG64 *>(&record->Sequence), 0);
+    record->Tick = KeQueryInterruptTime();
+    record->Generation = m_transportGeneration;
+    record->Event = event;
+    record->Node = node;
+    record->Engine = engine;
+    record->Context = context;
+    record->Flags = flags;
+    record->Fence = fence;
+    record->Response = response;
+    record->PendingPreemption = pending;
+    InterlockedExchange64(reinterpret_cast<volatile LONG64 *>(&record->Sequence), sequence);
+}
+
+void VioGpuAdapter::CopyTrace(VIOGPU_TRACE *trace)
+{
+    trace->Magic = 0x56475458;
+    trace->Version = 1;
+    trace->Size = sizeof(*trace);
+    trace->Count = RTL_NUMBER_OF(m_trace);
+    trace->LastSequence = InterlockedCompareExchange64(&m_traceSequence, 0, 0);
+    for (UINT i = 0; i < RTL_NUMBER_OF(m_trace); ++i)
+    {
+        LONG64 before = InterlockedCompareExchange64(reinterpret_cast<volatile LONG64 *>(&m_trace[i].Sequence), 0, 0);
+        VIOGPU_TRACE_RECORD record = m_trace[i];
+        LONG64 after = InterlockedCompareExchange64(reinterpret_cast<volatile LONG64 *>(&m_trace[i].Sequence), 0, 0);
+        if (!before || before != after || record.Sequence != (UINT64)before)
+            RtlZeroMemory(&record, sizeof(record));
+        trace->Records[i] = record;
+    }
+}
