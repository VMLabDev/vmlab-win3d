+void VioGpuQueue::StopSubmissions(void)
+{
+    KIRQL savedIrql;
+    Lock(&savedIrql);
+    InterlockedExchange(&m_SubmissionsStopped, 1);
+    Unlock(savedIrql);
+}
+
+void VioGpuQueue::CancelBufferAfterReset(PGPU_VBUFFER buf)
+{
+    if (!buf)
+    {
+        return;
+    }
+
+    if (buf->resp_buf && buf->resp_size >= sizeof(GPU_CTRL_HDR))
+    {
+        RtlZeroMemory(buf->resp_buf, buf->resp_size);
+        reinterpret_cast<PGPU_CTRL_HDR>(buf->resp_buf)->type = VIRTIO_GPU_RESP_ERR_UNSPEC;
+    }
+
+    // A synchronous waiter may release its buffer as soon as its callback wakes
+    // it. Capture ownership first and leave caller-owned buffers untouched after
+    // invoking the callback.
+    bool autoRelease = buf->auto_release;
+    void (*completeCb)(void *) = buf->complete_cb;
+    void *completeCtx = buf->complete_ctx;
+    if (completeCb)
+    {
+        completeCb(completeCtx);
+    }
+    if (autoRelease)
+    {
+        ReleaseBuffer(buf);
+    }
+}
+
+void VioGpuQueue::CancelPendingAfterReset(void)
+{
+    ASSERT(m_SubmissionsStopped != 0);
+    LIST_ENTRY cancelled;
+    InitializeListHead(&cancelled);
+    PGPU_VBUFFER buf;
+    while (m_pVirtQueue &&
+           (buf = reinterpret_cast<PGPU_VBUFFER>(virtqueue_detach_unused_buf(m_pVirtQueue))) != NULL)
+    {
+        InsertTailList(&cancelled, &buf->ctrl_queue_entry);
+    }
+    while (!IsListEmpty(&cancelled))
+    {
+        buf = CONTAINING_RECORD(RemoveHeadList(&cancelled), GPU_VBUFFER, ctrl_queue_entry);
+        CancelBufferAfterReset(buf);
+    }
+}
+
+void CtrlQueue::StopSubmissions(void)
+{
+    PAGED_CODE();
+    VioGpuQueue::StopSubmissions();
+    KIRQL savedIrql;
+    KeAcquireSpinLock(&m_CtrlQueueSpinLock, &savedIrql);
+    BOOLEAN flushing = m_CtrlQueueFlushInProgress != 0;
+    KeReleaseSpinLock(&m_CtrlQueueSpinLock, savedIrql);
+    if (flushing)
+    {
+        KeWaitForSingleObject(&m_CtrlQueueFlushIdle, Executive, KernelMode, FALSE, NULL);
+    }
+}
+
+void CtrlQueue::CancelPendingAfterReset(void)
+{
+    ASSERT(m_SubmissionsStopped != 0);
+    ASSERT(m_CtrlQueueFlushInProgress == 0);
+    LIST_ENTRY cancelled;
+    InitializeListHead(&cancelled);
+    PLIST_ENTRY entry;
+    while ((entry = ExInterlockedRemoveHeadList(&m_CtrlQueueList, &m_CtrlQueueSpinLock)) != NULL)
+    {
+        InsertTailList(&cancelled, entry);
+    }
+
+    // Detach every descriptor before invoking callbacks: callbacks may release
+    // command objects shared by multiple buffers and re-enter queue methods.
+    VioGpuQueue::CancelPendingAfterReset();
+    while (!IsListEmpty(&cancelled))
+    {
+        PGPU_VBUFFER buf = CONTAINING_RECORD(RemoveHeadList(&cancelled), GPU_VBUFFER, ctrl_queue_entry);
+        CancelBufferAfterReset(buf);
+    }
+    InterlockedExchange(&m_CtrlQueueFlushRequested, 0);
+}
