+void VioGpuAllocation::InvalidateHostResource()
+{
+    PAGED_CODE();
+    // Called only after device reset, cancellation, and DPC drain. The OS
+    // allocation and its MDL remain alive until VidMm evicts/destroys them.
+    ExAcquireFastMutex(&m_blob_map_mutex);
+    LIST_ENTRY mappings;
+    InitializeListHead(&mappings);
+    while (!IsListEmpty(&m_blob_map_list))
+        InsertTailList(&mappings, RemoveHeadList(&m_blob_map_list));
+    ExReleaseFastMutex(&m_blob_map_mutex);
+    while (!IsListEmpty(&mappings))
+    {
+        BlobUserMapping *map = CONTAINING_RECORD(RemoveHeadList(&mappings), BlobUserMapping, ListEntry);
+        BOOLEAN attached = map->Process && map->Process != PsGetCurrentProcess();
+        if (attached)
+            KeAttachProcess(reinterpret_cast<PRKPROCESS>(map->Process));
+        NTSTATUS status = STATUS_SUCCESS;
+        if (map->UserVa)
+            status = m_adapter->GetDxgkInterface()->DxgkCbUnmapMemory(m_adapter->GetDxgkInterface()->DeviceHandle, map->UserVa);
+        if (attached)
+            KeDetachProcess();
+        if (!NT_SUCCESS(status))
+        {
+            // Keep the process reference and aperture reservation for final
+            // cleanup. Never recycle a range while a guest VA still maps it.
+            ExAcquireFastMutex(&m_blob_map_mutex);
+            InsertTailList(&m_blob_map_list, &map->ListEntry);
+            ExReleaseFastMutex(&m_blob_map_mutex);
+            DbgPrint(TRACE_LEVEL_ERROR, ("TDR blob unmap failed resource=%u pid=%p status=%#x\n", m_Id, map->ProcessId, status));
+            continue;
+        }
+        if (map->Process)
+            ObDereferenceObject(map->Process);
+        delete map;
+    }
+    ExAcquireFastMutex(&m_blob_map_mutex);
+    if (IsListEmpty(&m_blob_map_list))
+        m_blob_map_user_refs = 0;
+    if (m_blob_kernel_va)
+        MmUnmapIoSpace(m_blob_kernel_va, (SIZE_T)m_blob_kernel_map_size);
+    m_blob_kernel_va = NULL;
+    m_blob_kernel_map_size = 0;
+    m_blob_created = false;
+    m_blob_mapped = false;
+    m_blob_map_info = 0;
+    m_resource_created = 0;
+    m_blob_create_status = STATUS_DEVICE_REMOVED;
+    InterlockedExchange(&m_blob_create_state, 0);
+    KeSetEvent(&m_blob_create_complete_event, IO_NO_INCREMENT, FALSE);
+    // Blob IDs name objects inside the lost renderer context. Reimporting
+    // one into an empty context would fabricate surviving Vulkan state.
+    if (m_is_blob)
+        m_valid = false;
+    // Keep its aperture reservation until destruction; stale user mappings
+    // must never alias a newly allocated resource after reset.
+    ExReleaseFastMutex(&m_blob_map_mutex);
+}
+
+NTSTATUS VioGpuAllocation::RestoreHostResource()
+{
+    PAGED_CODE();
+    if (!m_valid || m_is_blob || m_resource_created)
+        return STATUS_SUCCESS;
+    NTSTATUS status = m_adapter->ctrlQueue.CreateResource3DWait(m_Id, &m_options);
+    if (!NT_SUCCESS(status))
+        return status;
+    m_resource_created = 1;
+    if (m_pMDL && m_pageCount)
+    {
+        GPU_MEM_ENTRY *entries = new (NonPagedPoolNx) GPU_MEM_ENTRY[m_pageCount];
+        if (!entries)
+            return STATUS_INSUFFICIENT_RESOURCES;
+        for (size_t i = 0; i < m_pageCount; ++i)
+        {
+            entries[i].addr = MmGetMdlPfnArray(m_pMDL)[m_pageOffset + i] * PAGE_SIZE;
+            entries[i].length = PAGE_SIZE;
+            entries[i].padding = 0;
+        }
+        status = m_adapter->ctrlQueue.AttachBackingWait(m_Id, entries, (UINT)m_pageCount);
+    }
+    return status;
+}
