+    InsertTailList(kind == 0 ? &m_devices : kind == 1 ? &m_allocations : &m_deviceAllocations, entry);
+    KeReleaseMutex(&m_objectMutex, FALSE);
+}
+
+void VioGpuAdapter::UnregisterObject(LIST_ENTRY *entry)
+{
+    KeWaitForSingleObject(&m_objectMutex, Executive, KernelMode, FALSE, NULL);
+    RemoveEntryList(entry);
+    InitializeListHead(entry);
