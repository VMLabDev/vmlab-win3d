+
+NTSTATUS VioGpuAdapter::QuiesceTransport()
+{
+    PAGED_CODE();
+    vidpn.StopVsyncTimer();
+    // Gate producers before synchronizing with the interrupt/DPC consumers.
+    // Do not join the config worker until reset cancellation wakes its wait.
+    ctrlQueue.StopSubmissions();
+    m_CursorQueue.StopSubmissions();
+    InterlockedExchange(&m_InterruptsClosing, 1);
+    SynchronizeInterruptsForClose();
+    ctrlQueue.DisableInterrupt();
+    m_CursorQueue.DisableInterrupt();
+    KeFlushQueuedDpcs();
+    virtio_device_reset(&m_VioDev);
+    if (virtio_get_status(&m_VioDev) != 0)
+        return STATUS_IO_TIMEOUT;
+    // Virtio reset acknowledgement ends device access to descriptor buffers
+    // and backing memory. Never release these before observing status zero.
+    SetHardwareInit(FALSE);
+    InterlockedExchange((PLONG)&m_PendingWorks, 0);
+    for (UINT node = 0; node < kMaxTrackedNodes; ++node)
+    {
+        for (UINT engine = 0; engine < kMaxTrackedEngines; ++engine)
+        {
+            VIOGPU_DMA_RETIREMENT_QUEUE *queue = &m_dmaRetirement[node][engine];
+            while (queue->Head)
+            {
+                VIOGPU_DMA_RETIREMENT *entry = queue->Head;
+                queue->Head = entry->Next;
+                entry->Next = NULL;
+                if (entry->Packet)
+                {
+                    PGPU_VBUFFER packet = static_cast<PGPU_VBUFFER>(entry->Packet);
+                    entry->Packet = NULL;
+                    CtrlStagePushFromIsr(packet, entry->Length);
+                }
+            }
+            queue->Tail = NULL;
+        }
+    }
+    // Detach every retirement list before any callback can free its command.
+    ctrlQueue.CancelPendingAfterReset();
+    m_CursorQueue.CancelPendingAfterReset();
+    PGPU_VBUFFER packet;
+    UINT length;
+    while (CtrlStagePopForDpc(&packet, &length))
+        ctrlQueue.CancelBufferAfterReset(packet);
+    LIST_ENTRY *prepared;
+    while ((prepared = ExInterlockedRemoveHeadList(&m_preparedCommands, &m_preparedCommandLock)) != NULL)
+    {
+        InitializeListHead(prepared);
+        CONTAINING_RECORD(prepared, VioGpuCommand, m_preparedEntry)->CancelBeforeRun();
+    }
+    StopWorkThread();
+    KeClearEvent(&m_ConfigUpdateEvent);
+    virtio_delete_queues(&m_VioDev);
+    ctrlQueue.Close();
+    m_CursorQueue.Close();
+    virtio_device_shutdown(&m_VioDev);
+    RtlZeroMemory((void *)m_lastNotifiedFence, sizeof(m_lastNotifiedFence));
+    RtlZeroMemory((void *)m_lastSubmittedFence, sizeof(m_lastSubmittedFence));
+    RtlZeroMemory((void *)m_preemptSubmittedOutstanding, sizeof(m_preemptSubmittedOutstanding));
+    RtlZeroMemory((void *)m_pendingPreemptionFence, sizeof(m_pendingPreemptionFence));
+    return STATUS_SUCCESS;
+}
+
+void VioGpuAdapter::InvalidateHostObjects()
+{
+    PAGED_CODE();
+    KeWaitForSingleObject(&m_objectMutex, Executive, KernelMode, FALSE, NULL);
+    for (LIST_ENTRY *entry = m_devices.Flink; entry != &m_devices; entry = entry->Flink)
+    {
+        VioGpuDevice *device = CONTAINING_RECORD(entry, VioGpuDevice, m_adapterEntry);
+        device->m_context_created = false;
+        device->m_context_lost = device->m_capset_id != 0;
+    }
+    for (LIST_ENTRY *entry = m_deviceAllocations.Flink; entry != &m_deviceAllocations; entry = entry->Flink)
+        CONTAINING_RECORD(entry, VioGpuDeviceAllocation, m_adapterEntry)->m_attached = false;
+    for (LIST_ENTRY *entry = m_allocations.Flink; entry != &m_allocations; entry = entry->Flink)
+        CONTAINING_RECORD(entry, VioGpuAllocation, m_adapterEntry)->InvalidateHostResource();
+    KeReleaseMutex(&m_objectMutex, FALSE);
+    vidpn.Powerdown();
+}
+
+NTSTATUS VioGpuAdapter::RestoreHostObjects()
+{
+    PAGED_CODE();
+    NTSTATUS status = VioGpuAdapterInit();
+    if (!NT_SUCCESS(status))
+        return status;
+    ctrlQueue.SetGpuBuf(&m_GpuBuf);
+    m_CursorQueue.SetGpuBuf(&m_GpuBuf);
+    KeWaitForSingleObject(&m_objectMutex, Executive, KernelMode, FALSE, NULL);
+    for (LIST_ENTRY *entry = m_devices.Flink; entry != &m_devices; entry = entry->Flink)
+    {
+        VioGpuDevice *device = CONTAINING_RECORD(entry, VioGpuDevice, m_adapterEntry);
+        // GDI contexts have no opaque UMD protocol state. A lost Vulkan or
+        // VirGL device must be recreated by its UMD, never replayed empty.
+        if (device->m_context_lost)
+            continue;
+        status = ctrlQueue.CreateCtxWait(device->m_id, device->m_capset_id);
+        if (!NT_SUCCESS(status))
+            break;
+        device->m_context_created = true;
+    }
+    for (LIST_ENTRY *entry = m_allocations.Flink; NT_SUCCESS(status) && entry != &m_allocations; entry = entry->Flink)
+        status = CONTAINING_RECORD(entry, VioGpuAllocation, m_adapterEntry)->RestoreHostResource();
+    for (LIST_ENTRY *entry = m_deviceAllocations.Flink; NT_SUCCESS(status) && entry != &m_deviceAllocations; entry = entry->Flink)
+    {
+        VioGpuDeviceAllocation *allocation = CONTAINING_RECORD(entry, VioGpuDeviceAllocation, m_adapterEntry);
+        if (allocation->m_pDevice->IsContextCreated() && allocation->m_pAllocation->IsValid() &&
+            (allocation->m_pAllocation->IsBlob() || !allocation->m_pDevice->IsVenusContext()))
+        {
+            status = ctrlQueue.AttachResourceToCtxWait(allocation->m_pDevice->GetId(), allocation->m_pAllocation->GetId());
+            allocation->m_attached = NT_SUCCESS(status);
+        }
+    }
+    KeReleaseMutex(&m_objectMutex, FALSE);
+    if (NT_SUCCESS(status))
+        status = StartWorkThread();
+    if (!NT_SUCCESS(status))
+    {
+        NTSTATUS resetStatus = QuiesceTransport();
+        if (!NT_SUCCESS(resetStatus))
+            return resetStatus;
+        InvalidateHostObjects();
+    }
+    return status;
+}
+
+NTSTATUS VioGpuAdapter::ResetFromTimeout()
+{
+    PAGED_CODE();
+    KeWaitForSingleObject(&m_recoveryMutex, Executive, KernelMode, FALSE, NULL);
+    ++m_tdr.ResetCount;
+    Trace(6);
+    CopyTrace(&m_timeoutTrace);
+    m_tdr.RecoveryState = 1;
+    m_tdr.LastSubmittedFence = m_lastSubmittedFence[VIOGPU_RENDER_NODE][0];
+    m_tdr.LastCompletedFence = m_lastNotifiedFence[VIOGPU_RENDER_NODE][0];
+    m_tdr.PendingPreemptionFence = m_pendingPreemptionFence[VIOGPU_RENDER_NODE][0];
+    // Capture every engine before discarding its reset generation. Preserve
+    // the first outstanding engine in the read-only recovery diagnostics.
+    BOOLEAN captured = FALSE;
+    InterlockedExchange(&m_InterruptsClosing, 1);
+    SynchronizeInterruptsForClose();
+    for (UINT node = 0; node < kMaxTrackedNodes; ++node)
+    {
+        for (UINT engine = 0; engine < kMaxTrackedEngines; ++engine)
+        {
+            UINT submitted = m_lastSubmittedFence[node][engine];
+            UINT completed = m_lastNotifiedFence[node][engine];
+            UINT pending = m_pendingPreemptionFence[node][engine];
+            if (!captured && (submitted != completed || pending))
+            {
+                m_tdr.LastSubmittedFence = submitted;
+                m_tdr.LastCompletedFence = completed;
+                m_tdr.PendingPreemptionFence = pending;
+                captured = TRUE;
+            }
+            if (submitted || completed || pending)
+                DbgPrint(TRACE_LEVEL_ERROR, ("TDR node=%u engine=%u submitted=%u completed=%u preemption=%u outstanding=%ld\n",
+                    node, engine, submitted, completed, pending, m_preemptSubmittedOutstanding[node][engine]));
+        }
+    }
+    NTSTATUS status = IsHardwareInit() ? QuiesceTransport() : STATUS_DEVICE_NOT_READY;
+    if (NT_SUCCESS(status))
+    {
+        m_preserveShmem = TRUE;
+        InvalidateHostObjects();
+    }
+    m_tdr.LastResetStatus = status;
+    Trace(7, 0, 0, 0, 0, 0, status);
+    KeReleaseMutex(&m_recoveryMutex, FALSE);
+    return status;
+}
+
+NTSTATUS VioGpuAdapter::RestartFromTimeout()
+{
+    PAGED_CODE();
+    KeWaitForSingleObject(&m_recoveryMutex, Executive, KernelMode, FALSE, NULL);
+    ++m_tdr.RestartCount;
+    NTSTATUS status = STATUS_DEVICE_NOT_READY;
+    if (m_tdr.RecoveryState == 1 && NT_SUCCESS((NTSTATUS)m_tdr.LastResetStatus))
+    {
+        m_tdr.RecoveryState = 2;
+        status = RestoreHostObjects();
+        if (NT_SUCCESS(status))
+        {
+            m_tdr.RecoveryState = 0;
+            vidpn.StartVsyncTimer();
+        }
+    }
+    m_tdr.LastRestartStatus = status;
+    Trace(8, 0, 0, 0, 0, 0, status);
+    KeReleaseMutex(&m_recoveryMutex, FALSE);
+    return status;
+}
