diff --git a/libs/d3d12/bridge.c b/libs/d3d12/bridge.c
new file mode 100644
index 00000000..0b07af1e
--- /dev/null
+++ b/libs/d3d12/bridge.c
@@ -0,0 +1,305 @@
+/*
+ * System-wide d3d12.dll bridge for vmlab-win3d.
+ *
+ * This d3d12.dll replaces the one in System32 (and SysWOW64). It keeps the
+ * native export table, implements the device-creating exports with
+ * vkd3d-proton, and forwards everything else to the preserved native DLL.
+ * Its private files live in a directory next to the bridge itself:
+ *
+ *   <directory of this d3d12.dll>\vmlab-win3d\vkd3dcore.dll     vkd3d-proton core
+ *   <directory of this d3d12.dll>\vmlab-win3d\dxgi-vulkan.dll   DXVK DXGI only
+ *   <directory of this d3d12.dll>\vmlab-win3d\d3d12-native.dll  the original d3d12.dll
+ *
+ * Applications load the system dxgi.dll, whose swap chains cannot present a
+ * vkd3d-proton queue. The bridge therefore hooks the native DXGI factory's
+ * CreateSwapChain* methods. Swap chains for vkd3d-proton queues are created
+ * by the private DXVK DXGI; every other device goes to the native method.
+ *
+ * Copyright 2026 the vmlab-win3d contributors, after the bridge prototyped in
+ * the virtio driver-integrated-3d experiments.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifdef _WIN32
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+#define VKD3D_DBG_NO_FILE
+
+#define COBJMACROS
+#define VK_NO_PROTOTYPES
+#include "vkd3d_win32.h"
+#include "vkd3d_debug.h"
+#include "bridge.h"
+
+#define BRIDGE_PRIVATE_DIR L"vmlab-win3d"
+#define BRIDGE_PATH_MAX 1024
+
+typedef HRESULT (WINAPI *PFN_create_dxgi_factory2)(UINT flags, REFIID iid, void **factory);
+
+/* Native DRED data. The device is vkd3d-proton's, so the native runtime's
+ * DRED block stays empty; the export exists so the export table matches. */
+D3D12_VERSIONED_DEVICE_REMOVED_EXTENDED_DATA D3D12DeviceRemovedExtendedData;
+
+static bool bridge_private_path(const WCHAR *file, WCHAR *path, size_t size)
+{
+    HMODULE self;
+    WCHAR *slash;
+    DWORD len;
+
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            (const WCHAR *)bridge_private_path, &self))
+        return false;
+    len = GetModuleFileNameW(self, path, size);
+    if (!len || len >= size)
+        return false;
+    if (!(slash = wcsrchr(path, L'\\')))
+        return false;
+    slash[1] = 0;
+    if (wcslen(path) + wcslen(BRIDGE_PRIVATE_DIR) + 1 + wcslen(file) + 1 > size)
+        return false;
+    wcscat(path, BRIDGE_PRIVATE_DIR);
+    wcscat(path, L"\\");
+    wcscat(path, file);
+    return true;
+}
+
+HMODULE bridge_load_private_module(const WCHAR *file)
+{
+    WCHAR path[BRIDGE_PATH_MAX];
+    HMODULE module;
+
+    if (!bridge_private_path(file, path, ARRAY_SIZE(path)))
+    {
+        ERR("Failed to build the private path for %s.\n", debugstr_w(file));
+        return NULL;
+    }
+    /* Dependencies of the private module resolve from its own directory
+     * first, then from System32. */
+    if (!(module = LoadLibraryExW(path, NULL, LOAD_WITH_ALTERED_SEARCH_PATH)))
+        ERR("Failed to load %s, error %lu.\n", debugstr_w(path), GetLastError());
+    return module;
+}
+
+static INIT_ONCE native_once = INIT_ONCE_STATIC_INIT;
+static HMODULE native_module;
+
+static BOOL CALLBACK bridge_init_native(INIT_ONCE *once, void *param, void **context)
+{
+    native_module = bridge_load_private_module(L"d3d12-native.dll");
+    return TRUE;
+}
+
+void *bridge_get_native_proc(const char *name)
+{
+    InitOnceExecuteOnce(&native_once, bridge_init_native, NULL, NULL);
+    return native_module ? (void *)GetProcAddress(native_module, name) : NULL;
+}
+
+struct bridge_forward_import
+{
+    const char *name;
+    WORD ordinal;
+};
+
+#include "bridge_exports.h"
+
+/* Defined by the generated thunks (bridge_exports.S). */
+extern void *bridge_forward_ptrs[BRIDGE_FORWARD_COUNT];
+extern void *const bridge_forward_fallbacks[BRIDGE_FORWARD_COUNT];
+
+void * __cdecl bridge_forward_resolve(unsigned int index);
+
+/* Called by the thunks on the first call to a forwarded export. */
+void * __cdecl bridge_forward_resolve(unsigned int index)
+{
+    const struct bridge_forward_import *import = &bridge_forward_imports[index];
+    void *proc;
+
+    proc = bridge_get_native_proc(import->name ? import->name : (const char *)(ULONG_PTR)import->ordinal);
+    if (!proc)
+    {
+        if (import->name)
+            WARN("Native d3d12 has no export %s.\n", import->name);
+        else
+            WARN("Native d3d12 has no export #%u.\n", import->ordinal);
+        proc = bridge_forward_fallbacks[index];
+    }
+    InterlockedExchangePointer(&bridge_forward_ptrs[index], proc);
+    return proc;
+}
+
+/* DXGI swap-chain routing. */
+
+typedef HRESULT (STDMETHODCALLTYPE *PFN_create_swapchain)(IDXGIFactory2 *factory,
+        IUnknown *device, DXGI_SWAP_CHAIN_DESC *desc, IDXGISwapChain **swapchain);
+typedef HRESULT (STDMETHODCALLTYPE *PFN_create_swapchain_for_hwnd)(IDXGIFactory2 *factory,
+        IUnknown *device, HWND window, const DXGI_SWAP_CHAIN_DESC1 *desc,
+        const DXGI_SWAP_CHAIN_FULLSCREEN_DESC *fullscreen_desc, IDXGIOutput *output, IDXGISwapChain1 **swapchain);
+typedef HRESULT (STDMETHODCALLTYPE *PFN_create_swapchain_for_core_window)(IDXGIFactory2 *factory,
+        IUnknown *device, IUnknown *window, const DXGI_SWAP_CHAIN_DESC1 *desc,
+        IDXGIOutput *output, IDXGISwapChain1 **swapchain);
+typedef HRESULT (STDMETHODCALLTYPE *PFN_create_swapchain_for_composition)(IDXGIFactory2 *factory,
+        IUnknown *device, const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGIOutput *output, IDXGISwapChain1 **swapchain);
+
+static PFN_create_swapchain native_create_swapchain;
+static PFN_create_swapchain_for_hwnd native_create_swapchain_for_hwnd;
+static PFN_create_swapchain_for_core_window native_create_swapchain_for_core_window;
+static PFN_create_swapchain_for_composition native_create_swapchain_for_composition;
+
+static INIT_ONCE hooks_once = INIT_ONCE_STATIC_INIT;
+static HRESULT hooks_result = E_FAIL;
+static INIT_ONCE vulkan_dxgi_once = INIT_ONCE_STATIC_INIT;
+static HRESULT vulkan_dxgi_result = E_FAIL;
+static IDXGIFactory2 *vulkan_dxgi_factory;
+
+static BOOL CALLBACK bridge_init_vulkan_dxgi(INIT_ONCE *once, void *param, void **context)
+{
+    PFN_create_dxgi_factory2 create_factory;
+    HMODULE module;
+
+    if (!(module = bridge_load_private_module(L"dxgi-vulkan.dll")))
+        return TRUE;
+    if (!(create_factory = (PFN_create_dxgi_factory2)(void *)GetProcAddress(module, "CreateDXGIFactory2")))
+    {
+        ERR("dxgi-vulkan.dll has no CreateDXGIFactory2.\n");
+        return TRUE;
+    }
+    vulkan_dxgi_result = create_factory(0, &IID_IDXGIFactory2, (void **)&vulkan_dxgi_factory);
+    if (FAILED(vulkan_dxgi_result))
+        ERR("Failed to create the DXVK DXGI factory, hr %#x.\n", vulkan_dxgi_result);
+    return TRUE;
+}
+
+/* Swap chains for vkd3d-proton queues go to DXVK, which presents through
+ * IDXGIVkSwapChainFactory. Anything else is a native device. */
+static IDXGIFactory2 *bridge_vulkan_factory_for(IUnknown *device, HRESULT *hr)
+{
+    IUnknown *swapchain_factory;
+
+    if (!device || FAILED(IUnknown_QueryInterface(device, &IID_IDXGIVkSwapChainFactory, (void **)&swapchain_factory)))
+        return NULL;
+    IUnknown_Release(swapchain_factory);
+
+    InitOnceExecuteOnce(&vulkan_dxgi_once, bridge_init_vulkan_dxgi, NULL, NULL);
+    *hr = vulkan_dxgi_result;
+    return vulkan_dxgi_factory;
+}
+
+static HRESULT STDMETHODCALLTYPE bridge_create_swapchain(IDXGIFactory2 *factory,
+        IUnknown *device, DXGI_SWAP_CHAIN_DESC *desc, IDXGISwapChain **swapchain)
+{
+    IDXGIFactory2 *vulkan;
+    HRESULT hr = S_OK;
+
+    if (!(vulkan = bridge_vulkan_factory_for(device, &hr)))
+        return SUCCEEDED(hr) ? native_create_swapchain(factory, device, desc, swapchain) : hr;
+    return IDXGIFactory2_CreateSwapChain(vulkan, device, desc, swapchain);
+}
+
+static HRESULT STDMETHODCALLTYPE bridge_create_swapchain_for_hwnd(IDXGIFactory2 *factory,
+        IUnknown *device, HWND window, const DXGI_SWAP_CHAIN_DESC1 *desc,
+        const DXGI_SWAP_CHAIN_FULLSCREEN_DESC *fullscreen_desc, IDXGIOutput *output, IDXGISwapChain1 **swapchain)
+{
+    IDXGIFactory2 *vulkan;
+    HRESULT hr = S_OK;
+
+    if (!(vulkan = bridge_vulkan_factory_for(device, &hr)))
+        return SUCCEEDED(hr) ? native_create_swapchain_for_hwnd(factory, device, window, desc,
+                fullscreen_desc, output, swapchain) : hr;
+    return IDXGIFactory2_CreateSwapChainForHwnd(vulkan, device, window, desc, fullscreen_desc, output, swapchain);
+}
+
+static HRESULT STDMETHODCALLTYPE bridge_create_swapchain_for_core_window(IDXGIFactory2 *factory,
+        IUnknown *device, IUnknown *window, const DXGI_SWAP_CHAIN_DESC1 *desc,
+        IDXGIOutput *output, IDXGISwapChain1 **swapchain)
+{
+    IDXGIFactory2 *vulkan;
+    HRESULT hr = S_OK;
+
+    if (!(vulkan = bridge_vulkan_factory_for(device, &hr)))
+        return SUCCEEDED(hr) ? native_create_swapchain_for_core_window(factory, device, window, desc,
+                output, swapchain) : hr;
+    return IDXGIFactory2_CreateSwapChainForCoreWindow(vulkan, device, window, desc, output, swapchain);
+}
+
+static HRESULT STDMETHODCALLTYPE bridge_create_swapchain_for_composition(IDXGIFactory2 *factory,
+        IUnknown *device, const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGIOutput *output, IDXGISwapChain1 **swapchain)
+{
+    IDXGIFactory2 *vulkan;
+    HRESULT hr = S_OK;
+
+    if (!(vulkan = bridge_vulkan_factory_for(device, &hr)))
+        return SUCCEEDED(hr) ? native_create_swapchain_for_composition(factory, device, desc, output, swapchain) : hr;
+    return IDXGIFactory2_CreateSwapChainForComposition(vulkan, device, desc, output, swapchain);
+}
+
+static BOOL CALLBACK bridge_init_hooks(INIT_ONCE *once, void *param, void **context)
+{
+    PFN_create_dxgi_factory2 create_factory;
+    IDXGIFactory2Vtbl *vtbl;
+    IDXGIFactory2 *factory;
+    DWORD old_protect;
+    HMODULE module;
+    HRESULT hr;
+
+    if (!(module = LoadLibraryExW(L"dxgi.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32)))
+    {
+        ERR("Failed to load the system dxgi.dll, error %lu.\n", GetLastError());
+        return TRUE;
+    }
+    if (!(create_factory = (PFN_create_dxgi_factory2)(void *)GetProcAddress(module, "CreateDXGIFactory2")))
+        return TRUE;
+    if (FAILED(hr = create_factory(0, &IID_IDXGIFactory2, (void **)&factory)))
+    {
+        ERR("Failed to create a native DXGI factory, hr %#x.\n", hr);
+        return TRUE;
+    }
+
+    /* Every native factory shares this vtable. Patch it once, and keep both
+     * dxgi.dll and this module loaded: hooked factories outlive any caller. */
+    vtbl = (IDXGIFactory2Vtbl *)factory->lpVtbl;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+            (const WCHAR *)bridge_init_hooks, &module)
+            || !GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+            (const WCHAR *)vtbl->CreateSwapChain, &module))
+    {
+        ERR("Failed to pin modules, error %lu.\n", GetLastError());
+        IDXGIFactory2_Release(factory);
+        return TRUE;
+    }
+    if (!VirtualProtect(vtbl, sizeof(*vtbl), PAGE_READWRITE, &old_protect))
+    {
+        ERR("Failed to unprotect the DXGI factory vtable, error %lu.\n", GetLastError());
+        IDXGIFactory2_Release(factory);
+        return TRUE;
+    }
+
+    native_create_swapchain = vtbl->CreateSwapChain;
+    native_create_swapchain_for_hwnd = vtbl->CreateSwapChainForHwnd;
+    native_create_swapchain_for_core_window = vtbl->CreateSwapChainForCoreWindow;
+    native_create_swapchain_for_composition = vtbl->CreateSwapChainForComposition;
+    InterlockedExchangePointer((void **)&vtbl->CreateSwapChain, (void *)bridge_create_swapchain);
+    InterlockedExchangePointer((void **)&vtbl->CreateSwapChainForHwnd, (void *)bridge_create_swapchain_for_hwnd);
+    InterlockedExchangePointer((void **)&vtbl->CreateSwapChainForCoreWindow,
+            (void *)bridge_create_swapchain_for_core_window);
+    InterlockedExchangePointer((void **)&vtbl->CreateSwapChainForComposition,
+            (void *)bridge_create_swapchain_for_composition);
+    VirtualProtect(vtbl, sizeof(*vtbl), old_protect, &old_protect);
+
+    TRACE("Native DXGI swap-chain hooks installed.\n");
+    hooks_result = S_OK;
+    IDXGIFactory2_Release(factory);
+    return TRUE;
+}
+
+HRESULT bridge_install_dxgi_hooks(void)
+{
+    InitOnceExecuteOnce(&hooks_once, bridge_init_hooks, NULL, NULL);
+    return hooks_result;
+}
+
+#endif /* _WIN32 */
