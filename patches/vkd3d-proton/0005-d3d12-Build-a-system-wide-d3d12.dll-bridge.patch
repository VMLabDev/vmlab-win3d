diff --git a/libs/d3d12/native_exports.txt b/libs/d3d12/native_exports.txt
new file mode 100644
index 00000000..d9c5fa2b
--- /dev/null
+++ b/libs/d3d12/native_exports.txt
@@ -0,0 +1,39 @@
+# Export table of the d3d12.dll bridge.
+#
+# The bridge replaces the system d3d12.dll. Every export of a stock Windows
+# 10/11 d3d12.dll is listed here; gen_exports.py turns this file into the
+# module definition (.def) and the forwarding thunks.
+#
+# Columns:
+#   name      export name, or #N for an export that has only an ordinal
+#   ordinal   export ordinal of the bridge
+#   kind      vkd3d   implemented by vkd3d-proton (main.c)
+#             forward forwarded at run time to the preserved native DLL
+#             data    a data export, defined by the bridge (bridge.c)
+#   argbytes  forward only: stdcall argument bytes on x86 (ret N)
+#   fallback  forward only: value returned if the native DLL lacks the export
+#
+# Ordinals: only 99, 101 and 102 are the same in every Windows build checked
+# (Win10 19045 and Win11 26100), and Windows' own DLLs import d3d12.dll by
+# ordinal only for 101 and 102. Everything else is imported by name, so the
+# remaining ordinals follow the Win11 26100 layout.
+
+#99                                           99  forward  16  0x80004001
+SetAppCompatStringPointer                     100 forward  8   0
+D3D12CreateDevice                             101 vkd3d
+D3D12GetDebugInterface                        102 vkd3d
+D3D12CoreCreateLayeredDevice                  103 forward  20  0x80004001
+D3D12CoreGetLayeredDeviceSize                 104 forward  8   0
+D3D12CoreRegisterLayers                       105 forward  8   0x80004001
+D3D12CreateRootSignatureDeserializer          106 vkd3d
+D3D12CreateVersionedRootSignatureDeserializer 107 vkd3d
+D3D12DeviceRemovedExtendedData                108 data
+D3D12EnableExperimentalFeatures               109 vkd3d
+D3D12GetInterface                             110 vkd3d
+D3D12PIXEventsReplaceBlock                    111 forward  4   0
+D3D12PIXGetThreadInfo                         112 forward  0   0
+D3D12PIXNotifyWakeFromFenceSignal             113 forward  4   0
+D3D12PIXReportCounter                         114 forward  8   0
+D3D12SerializeRootSignature                   115 vkd3d
+D3D12SerializeVersionedRootSignature          116 vkd3d
+GetBehaviorValue                              117 forward  8   0
