 libs/d3d12/bridge.h           |  22 +++
 libs/d3d12/gen_exports.py     | 145 ++++++++++++++++
 libs/d3d12/main.c             |  63 ++++---
 libs/d3d12/meson.build        |  17 +-
 libs/d3d12/native_exports.txt |  39 +++++
 6 files changed, 567 insertions(+), 24 deletions(-)
