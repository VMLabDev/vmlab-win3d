diff --git a/libs/d3d12/gen_exports.py b/libs/d3d12/gen_exports.py
new file mode 100644
index 00000000..e320edf2
--- /dev/null
+++ b/libs/d3d12/gen_exports.py
@@ -0,0 +1,145 @@
+#!/usr/bin/env python3
+# Generate the d3d12.dll bridge's module definition and forwarding thunks
+# from native_exports.txt.
+#
+# usage: gen_exports.py <native_exports.txt> <x86|x86_64> <out.def> <out.S> <out.h>
+#
+# Each forwarded export becomes a thunk that jumps through a pointer table.
+# The table starts out pointing at per-export resolver stubs. The first call
+# resolves the export in the preserved native DLL (bridge.c), patches the
+# table and continues into the resolved function with the caller's arguments
+# intact. An export the native DLL lacks resolves to a stub that returns the
+# listed fallback value and, on x86, pops the listed stdcall argument bytes.
+import sys
+
+
+def parse(path):
+    entries = []
+    with open(path) as f:
+        for line in f:
+            line = line.strip()
+            if not line or line.startswith("# ") or line == "#":
+                continue
+            fields = line.split()
+            name, ordinal, kind = fields[0], int(fields[1]), fields[2]
+            entry = {"name": name, "ordinal": ordinal, "kind": kind}
+            if kind == "forward":
+                entry["argbytes"] = int(fields[3])
+                entry["fallback"] = int(fields[4], 0)
+            elif kind not in ("vkd3d", "data"):
+                sys.exit(f"{path}: unknown kind {kind!r}")
+            entries.append(entry)
+    return entries
+
+
+def symbol(entry):
+    if entry["name"].startswith("#"):
+        return "bridge_native_ordinal_" + entry["name"][1:]
+    return entry["name"]
+
+
+def write_def(entries, path):
+    with open(path, "w") as f:
+        f.write("; Generated by gen_exports.py from native_exports.txt.\n")
+        f.write("LIBRARY d3d12.dll\n\nEXPORTS\n")
+        for e in entries:
+            line = f"    {symbol(e)} @{e['ordinal']}"
+            if e["name"].startswith("#"):
+                line += " NONAME"
+            if e["kind"] == "data":
+                line += " DATA"
+            f.write(line + "\n")
+
+
+def write_asm(entries, arch, path):
+    fwd = [e for e in entries if e["kind"] == "forward"]
+    x64 = arch == "x86_64"
+    p = "" if x64 else "_"
+    ptr = ".quad" if x64 else ".long"
+    size = 8 if x64 else 4
+    out = ["/* Generated by gen_exports.py from native_exports.txt. */", "    .text"]
+    for i, e in enumerate(fwd):
+        name = p + symbol(e)
+        out += [f"    .globl {name}", f"    .p2align 4", f"{name}:"]
+        if x64:
+            out.append(f"    jmp *{p}bridge_forward_ptrs+{i * size}(%rip)")
+        else:
+            out.append(f"    jmp *{p}bridge_forward_ptrs+{i * size}")
+    for i, e in enumerate(fwd):
+        out.append(f"bridge_resolve_{i}:")
+        if x64:
+            out += [f"    movl ${i}, %eax", "    jmp bridge_resolve_common"]
+        else:
+            out += [f"    pushl ${i}", "    jmp bridge_resolve_common"]
+    if x64:
+        # Preserve the four argument registers (integer and vector) around
+        # the resolver call; keep the stack 16-byte aligned with shadow space.
+        out += [
+            "bridge_resolve_common:",
+            "    pushq %rcx", "    pushq %rdx", "    pushq %r8", "    pushq %r9",
+            "    subq $0x68, %rsp",
+            "    movdqu %xmm0, 0x20(%rsp)", "    movdqu %xmm1, 0x30(%rsp)",
+            "    movdqu %xmm2, 0x40(%rsp)", "    movdqu %xmm3, 0x50(%rsp)",
+            "    movl %eax, %ecx",
+            "    call bridge_forward_resolve",
+            "    movq %rax, %r11",
+            "    movdqu 0x20(%rsp), %xmm0", "    movdqu 0x30(%rsp), %xmm1",
+            "    movdqu 0x40(%rsp), %xmm2", "    movdqu 0x50(%rsp), %xmm3",
+            "    addq $0x68, %rsp",
+            "    popq %r9", "    popq %r8", "    popq %rdx", "    popq %rcx",
+            "    jmp *%r11",
+        ]
+    else:
+        # Stack arguments stay where they are; ecx and edx are preserved for
+        # thiscall/fastcall-style callers. The index pushed by the stub is
+        # dropped before the jump.
+        out += [
+            "bridge_resolve_common:",
+            "    pushl %ecx", "    pushl %edx",
+            "    pushl 8(%esp)",
+            "    call _bridge_forward_resolve",
+            "    addl $4, %esp",
+            "    popl %edx", "    popl %ecx",
+            "    addl $4, %esp",
+            "    jmp *%eax",
+        ]
+    for i, e in enumerate(fwd):
+        out += [f"bridge_fallback_{i}:", f"    movl ${e['fallback']:#x}, %eax", "    xorl %edx, %edx"]
+        if x64 or not e["argbytes"]:
+            out.append("    ret")
+        else:
+            out.append(f"    ret ${e['argbytes']}")
+    out += ["", "    .data", f"    .p2align {3 if x64 else 2}", f"    .globl {p}bridge_forward_ptrs",
+            f"{p}bridge_forward_ptrs:"]
+    out += [f"    {ptr} bridge_resolve_{i}" for i in range(len(fwd))]
+    out += [f"    .globl {p}bridge_forward_fallbacks", f"{p}bridge_forward_fallbacks:"]
+    out += [f"    {ptr} bridge_fallback_{i}" for i in range(len(fwd))]
+    with open(path, "w") as f:
+        f.write("\n".join(out) + "\n")
+
+
+def write_header(entries, path):
+    fwd = [e for e in entries if e["kind"] == "forward"]
+    with open(path, "w") as f:
+        f.write("/* Generated by gen_exports.py from native_exports.txt. */\n")
+        f.write(f"#define BRIDGE_FORWARD_COUNT {len(fwd)}\n")
+        f.write("static const struct bridge_forward_import bridge_forward_imports[BRIDGE_FORWARD_COUNT] =\n{\n")
+        for e in fwd:
+            if e["name"].startswith("#"):
+                f.write(f"    {{NULL, {e['name'][1:]}}},\n")
+            else:
+                f.write(f"    {{\"{e['name']}\", 0}},\n")
+        f.write("};\n")
+
+
+def main():
+    if len(sys.argv) != 6:
+        sys.exit("usage: gen_exports.py <list> <arch> <def> <S> <h>")
+    entries = parse(sys.argv[1])
+    write_def(entries, sys.argv[3])
+    write_asm(entries, sys.argv[2], sys.argv[4])
+    write_header(entries, sys.argv[5])
+
+
+if __name__ == "__main__":
+    main()
