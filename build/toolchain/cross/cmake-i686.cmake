# CMake toolchain file: i686 Windows (ucrt) with llvm-mingw in /opt/llvm-mingw.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)
set(CMAKE_C_COMPILER /opt/llvm-mingw/bin/i686-w64-mingw32-clang)
set(CMAKE_CXX_COMPILER /opt/llvm-mingw/bin/i686-w64-mingw32-clang++)
set(CMAKE_RC_COMPILER /opt/llvm-mingw/bin/i686-w64-mingw32-windres)
set(CMAKE_ASM_COMPILER /opt/llvm-mingw/bin/i686-w64-mingw32-clang)
set(CMAKE_AR /opt/llvm-mingw/bin/llvm-ar)
set(CMAKE_RANLIB /opt/llvm-mingw/bin/llvm-ranlib)
set(CMAKE_FIND_ROOT_PATH /opt/llvm-mingw/i686-w64-mingw32)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
